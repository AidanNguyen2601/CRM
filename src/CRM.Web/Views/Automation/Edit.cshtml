@model AutomationRule
@{
    ViewData["Title"] = Model.Id == 0 ? T("Thêm quy tắc tự động") : T("Sửa quy tắc: {0}", Model.Name);
    var timeTriggers = AutomationService.TimeTriggers.Select(t => (int)t).ToArray();
}
<form asp-action="Edit" method="post" id="ruleForm" style="max-width:860px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="@T("Vd. Lead mới → gọi điện trong 1 ngày")" /></div>
        <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive"></label></div></div>
    </div></div>

    <div class="card mb-3"><div class="card-header">@T("KHI")</div><div class="card-body row g-3">
        <div class="col-md-7"><label asp-for="Trigger" class="form-label">@T("Sự kiện")</label>
            <select asp-for="Trigger" class="form-select" asp-items="Html.GetEnumSelectList<AutomationTrigger>()" id="trigger"></select></div>
        <div class="col-md-5" data-show="days"><label asp-for="Days" class="form-label"></label><input asp-for="Days" type="number" min="1" class="form-control" /></div>
        <div class="col-md-5" data-show="stage"><label class="form-label">@T("Giai đoạn mới")</label>
            <select name="Condition" class="form-select cond" data-for="3"><option value="">@T("-- Bất kỳ --")</option>
                @foreach (var s in Enum.GetValues<OpportunityStage>()) { <option value="@((int)s)" selected="@(Model.Trigger == AutomationTrigger.OpportunityStageChanged && Model.Condition == (int)s)">@s.GetDisplayName()</option> }</select></div>
        <div class="col-md-5" data-show="priority"><label class="form-label">@T("Độ ưu tiên phiếu")</label>
            <select name="Condition" class="form-select cond" data-for="7"><option value="">@T("-- Bất kỳ --")</option>
                @foreach (var s in Enum.GetValues<TicketPriority>()) { <option value="@((int)s)" selected="@(Model.Trigger == AutomationTrigger.TicketCreated && Model.Condition == (int)s)">@s.GetDisplayName()</option> }</select></div>
        <div class="col-md-5" data-show="source"><label class="form-label">@T("Nguồn lead")</label>
            <select name="Condition" class="form-select cond" data-for="1"><option value="">@T("-- Bất kỳ --")</option>
                @foreach (var s in Enum.GetValues<LeadSource>()) { <option value="@((int)s)" selected="@(Model.Trigger == AutomationTrigger.LeadCreated && Model.Condition == (int)s)">@s.GetDisplayName()</option> }</select></div>
    </div></div>

    <div class="card mb-3"><div class="card-header">@T("THÌ")</div><div class="card-body row g-3">
        <div class="col-md-6"><label asp-for="Action" class="form-label">@T("Hành động")</label>
            <select asp-for="Action" class="form-select" asp-items="Html.GetEnumSelectList<AutomationAction>()" id="action"></select></div>
        <div class="col-md-6" data-show="assignee"><label asp-for="Assignee" class="form-label"></label>
            <select asp-for="Assignee" class="form-select" asp-items="Html.GetEnumSelectList<AutomationAssignee>()" id="assignee"></select></div>
        <div class="col-md-6" data-show="user"><label class="form-label">@T("Người dùng")</label>
            <select asp-for="AssigneeUserId" class="form-select" asp-items="ViewBag.Users"><option value="">@T("-- Chọn --")</option></select></div>
        <div class="col-md-6" data-show="template"><label asp-for="EmailTemplateId" class="form-label"></label>
            <select asp-for="EmailTemplateId" class="form-select" asp-items="ViewBag.Templates"><option value="">@T("-- Dùng tiêu đề / nội dung bên dưới --")</option></select></div>
        <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-12"><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" rows="3" class="form-control"></textarea>
            <div class="form-text">@T("Biến: {{Ten}} = tên bản ghi (lead, cơ hội, hợp đồng...), {{KhachHang}} = khách hàng, {{SoNgay}} = số ngày của sự kiện, {{Ngay}} = hôm nay.")</div></div>
        <div class="col-md-4" data-show="task"><label asp-for="TaskDueDays" class="form-label"></label><input asp-for="TaskDueDays" type="number" min="0" max="365" class="form-control" />
            <div class="form-text">@T("0 = trong 2 giờ")</div></div>
        <div class="col-md-4" data-show="task"><label asp-for="TaskPriority" class="form-label"></label>
            <select asp-for="TaskPriority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div>
    </div></div>
    <div class="d-flex gap-2"><button class="btn btn-primary">@T("Lưu quy tắc")</button><a class="btn btn-light" asp-action="Index">@T("Hủy")</a></div>
</form>
@section Scripts {
<script>
    (function () {
        const time = @Json.Serialize(timeTriggers);
        const trig = document.getElementById('trigger'), act = document.getElementById('action'), asg = document.getElementById('assignee');
        function show(key, on) { document.querySelectorAll('[data-show="' + key + '"]').forEach(el => { el.classList.toggle('d-none', !on); el.querySelectorAll('select,input').forEach(i => i.disabled = !on); }); }
        function apply() {
            const t = +trig.value, a = +act.value;
            show('days', time.includes(t) && t !== 8);
            show('stage', t === 3); show('priority', t === 7); show('source', t === 1);
            show('task', a === 1); show('assignee', a !== 3); show('template', a === 3);
            show('user', a !== 3 && +asg.value === 3);
        }
        [trig, act, asg].forEach(s => s.addEventListener('change', apply));
        apply();
    })();
</script>
}
