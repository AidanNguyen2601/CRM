@model CampaignDetailViewModel
@{
    var c = Model.Campaign;
    var s = Model.Stats;
    var f = Model.Filter;
    ViewData["Title"] = $"{c.Code} · {c.Name}";
    int Count(CampaignMemberStatus st) => Model.StatusCounts.TryGetValue(st, out var n) ? n : 0;
    string Tab(CampaignMemberStatus? st) => f.MemberStatus == st ? "active" : "";
    // Kênh tiếp cận 1-1 → mặc định ghi vào lịch sử chăm sóc; kênh gửi hàng loạt → mặc định không (tránh làm nhiễu KPI hoạt động)
    var personal = c.Channel is CampaignChannel.Telesales or CampaignChannel.Event or CampaignChannel.Webinar;
    var funnelMax = Math.Max(1, s.Members);
    var funnel = new (string Label, int Value)[]
    {
        (T("Đối tượng"), s.Members), (T("Đã tiếp cận"), s.Reached), (T("Quan tâm / phản hồi"), s.Positive),
        ("Lead", s.Leads), (T("Cơ hội"), s.Opportunities), (T("Thắng"), s.WonCount)
    };
}
<div class="toolbar">
    @if (Model.CanEdit)
    {
        if (c.Status == CampaignStatus.Planned)
        {
            <form asp-action="SetStatus" asp-route-id="@c.Id" method="post"><input type="hidden" name="status" value="@CampaignStatus.Active" /><button class="btn btn-success">@Icon("send") @T("Bắt đầu triển khai")</button></form>
        }
        if (c.Status == CampaignStatus.Active)
        {
            <form asp-action="SetStatus" asp-route-id="@c.Id" method="post" data-confirm="@T("Kết thúc chiến dịch này?")"><input type="hidden" name="status" value="@CampaignStatus.Completed" /><button class="btn btn-success">@Icon("check") @T("Kết thúc chiến dịch")</button></form>
        }
        if (!c.IsOpen)
        {
            <form asp-action="SetStatus" asp-route-id="@c.Id" method="post"><input type="hidden" name="status" value="@CampaignStatus.Active" /><button class="btn btn-outline-success">@Icon("undo") @T("Mở lại")</button></form>
        }
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">@T("Sửa")</a>
        if (c.IsOpen)
        {
            <a class="btn btn-primary" asp-action="Segment" asp-route-id="@c.Id">@Icon("target") @T("Thêm đối tượng")</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Leads" asp-action="Create" asp-route-campaignId="@c.Id">@T("+ Lead từ chiến dịch")</a>
        <a class="btn btn-outline-secondary" asp-action="Export" asp-route-id="@c.Id" asp-route-memberStatus="@f.MemberStatus">@Icon("download") @T("Xuất CSV")</a>
        <div class="ms-auto d-flex gap-2">
            @if (c.IsOpen)
            {
                <form asp-action="SetStatus" asp-route-id="@c.Id" method="post" data-confirm="@T("Hủy chiến dịch này?")"><input type="hidden" name="status" value="@CampaignStatus.Cancelled" /><button class="btn btn-outline-warning">@T("Hủy chiến dịch")</button></form>
            }
            <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="@T("Xóa chiến dịch {0} và toàn bộ danh sách đối tượng?", c.Code)"><button class="btn btn-outline-danger">@T("Xóa")</button></form>
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("contact", "stat-ico")@T("Đối tượng")</div><div class="value">@s.Members</div><div class="small text-muted">@T("Tiếp cận {0}%", s.ReachRate)</div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("email", "stat-ico")@T("Phản hồi")</div><div class="value">@s.Positive</div><div class="small text-muted">@T("Tỷ lệ {0}% · {1} từ chối", s.ResponseRate, s.Unsubscribed)</div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("lead", "stat-ico")Lead</div><div class="value">@s.Leads@if (c.TargetLeads > 0) { <small class="fs-6 text-muted">/@c.TargetLeads</small> }</div><div class="small text-muted">@T("{0} đã chuyển đổi", s.ConvertedLeads)</div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("opportunity", "stat-ico")@T("Cơ hội")</div><div class="value">@s.Opportunities</div><div class="small text-muted">@T("Pipeline {0}", s.Pipeline.ToShortMoney())</div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("trophy", "stat-ico")@T("Doanh số thắng")</div><div class="value text-success">@s.Won.ToShortMoney()</div><div class="small text-muted">@T("Kỳ vọng {0}", c.ExpectedRevenue.ToShortMoney())</div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat h-100"><div class="label">@Icon("coins", "stat-ico")ROI</div><div class="value @CampaignStats.RoiCss(s.Roi)">@(s.Roi.HasValue ? s.Roi.Value.ToString("0") + "%" : "—")</div><div class="small text-muted">@T("Chi phí / lead: {0}", s.CostPerLead?.ToShortMoney() ?? "—")</div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <h5 class="mb-1">@c.Name</h5>
                <partial name="_Badge" model="c.Status" />
            </div>
            <div class="text-muted mb-2">@Icon(ForChannel(c.Channel)) @c.Channel.GetDisplayName()</div>
            <dl class="row small mb-0 info">
                <dt class="col-5">@T("Thời gian")</dt><dd class="col-7">@c.StartDate.ToDate()@(c.EndDate.HasValue ? " – " + c.EndDate.ToDate() : "")</dd>
                <dt class="col-5">@T("Ngân sách")</dt><dd class="col-7">@c.Budget.ToMoney()</dd>
                <dt class="col-5">@T("Chi phí thực tế")</dt><dd class="col-7">@c.ActualCost.ToMoney() @if (c.Budget > 0) { <span class="badge @(s.BudgetUsed > 100 ? "bg-danger" : "bg-light text-dark border")">@s.BudgetUsed%</span> }</dd>
                <dt class="col-5">@T("Doanh số kỳ vọng")</dt><dd class="col-7">@c.ExpectedRevenue.ToMoney()</dd>
                <dt class="col-5">@T("Phụ trách")</dt><dd class="col-7">@c.Owner?.FullName</dd>
                <dt class="col-5">@T("Ngày tạo")</dt><dd class="col-7">@c.CreatedAt.ToDate()</dd>
            </dl>
            @if (!string.IsNullOrEmpty(c.Objective)) { <hr /><div class="small text-muted mb-1">@T("Mục tiêu / đối tượng")</div><div class="small pre">@c.Objective</div> }
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">@Icon("pipeline") @T("Phễu chiến dịch")</div>
            <div class="card-body">
                @foreach (var (label, value) in funnel)
                {
                    <div class="bar-row">
                        <div class="lbl">@label</div>
                        <div class="bar"><div style="width:@(Math.Min(100, value * 100 / funnelMax))%"></div></div>
                        <div class="val">@value</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><span>@Icon("email") @T("Nội dung thông điệp")</span>
                @if (!string.IsNullOrEmpty(c.Message)) { <button type="button" class="btn btn-sm btn-light" data-copy="#campaignMessage">@T("Sao chép")</button> }</div>
            <div class="card-body">
                @if (string.IsNullOrEmpty(c.Message)) { <div class="text-muted small">@T("Chưa có nội dung. Bấm Sửa để soạn email / tin nhắn / kịch bản gọi.")</div> }
                else { <div id="campaignMessage" class="small pre campaign-message">@c.Message</div> }
            </div>
        </div>
    </div>
</div>

@* ===== Danh sách đối tượng ===== *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>@Icon("contact") @T("Đối tượng chiến dịch")</span>
        <ul class="nav nav-pills nav-sm flex-wrap">
            <li class="nav-item"><a class="nav-link py-1 px-2 @Tab(null)" asp-route-id="@c.Id" asp-route-Keyword="@f.Keyword">@T("Tất cả") <span class="badge bg-secondary">@s.Members</span></a></li>
            @foreach (var st in Enum.GetValues<CampaignMemberStatus>().Where(x => Count(x) > 0))
            {
                <li class="nav-item"><a class="nav-link py-1 px-2 @Tab(st)" asp-route-id="@c.Id" asp-route-MemberStatus="@st" asp-route-Keyword="@f.Keyword">@st.GetDisplayName() <span class="badge bg-secondary">@Count(st)</span></a></li>
            }
        </ul>
    </div>
    <div class="card-body pb-0">
        <form method="get" class="toolbar mb-2">
            <input type="hidden" name="MemberStatus" value="@f.MemberStatus" />
            <div><input name="Keyword" value="@f.Keyword" class="form-control form-control-sm" placeholder="@T("Họ tên, công ty, email, SĐT")" /></div>
            <button class="btn btn-sm btn-outline-primary">@T("Lọc")</button>
        </form>
    </div>
    <form asp-action="UpdateMembers" asp-route-id="@c.Id" method="post" id="memberForm">
        @if (Model.CanEdit && Model.Members.Items.Any())
        {
            <div class="member-bulk px-3 pb-2 d-flex flex-wrap gap-2 align-items-end">
                <div><label class="form-label small mb-1">@T("Cập nhật đối tượng đã chọn thành")</label>
                    <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<CampaignMemberStatus>().Select(i => { i.Selected = i.Value == ((int)CampaignMemberStatus.Sent).ToString(); return i; })"></select></div>
                <div style="min-width:220px"><label class="form-label small mb-1">@T("Ghi chú")</label><input name="note" class="form-control form-control-sm" maxlength="500" /></div>
                <div class="form-check mb-1" title="@T("Tạo hoạt động đã hoàn thành trên khách hàng / lead (tính vào KPI hoạt động)")">
                    <input class="form-check-input" type="checkbox" name="logActivity" value="true" id="logActivity" checked="@personal" />
                    <label class="form-check-label small" for="logActivity">@T("Ghi vào lịch sử chăm sóc")</label>
                </div>
                <button class="btn btn-sm btn-primary" data-need-selection>@T("Cập nhật")</button>
                <button class="btn btn-sm btn-outline-danger" formaction="@Url.Action("RemoveMembers", new { id = c.Id })" data-need-selection data-confirm-click="@T("Bỏ các đối tượng đã chọn khỏi chiến dịch?")">@T("Bỏ khỏi chiến dịch")</button>
                <span class="small text-muted ms-auto" data-selection-count></span>
            </div>
        }
        <div class="table-responsive">
        <table class="table table-hover mb-0" data-no-grid>
            <thead><tr>
                @if (Model.CanEdit) { <th style="width:32px"><input type="checkbox" class="form-check-input" data-check-all="memberIds" aria-label="@T("Chọn tất cả")" /></th> }
                <th>@T("Họ tên")</th><th>@T("Công ty")</th><th>Email</th><th>@T("Điện thoại")</th><th>@T("Trạng thái")</th><th>@T("Lần tiếp cận gần nhất")</th><th>@T("Ghi chú")</th><th></th>
            </tr></thead>
            <tbody>
            @foreach (var m in Model.Members.Items)
            {
                <tr>
                    @if (Model.CanEdit) { <td><input type="checkbox" class="form-check-input" name="memberIds" value="@m.Id" /></td> }
                    <td class="fw-semibold">@m.FullName</td>
                    <td>@if (m.CustomerId.HasValue) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@m.CustomerId">@m.Company</a> } else { @m.Company }</td>
                    <td>@m.Email</td>
                    <td class="text-nowrap">@m.Phone</td>
                    <td><partial name="_Badge" model="m.Status" /></td>
                    <td class="small text-nowrap">@m.LastContactAt?.ToDateTime()</td>
                    <td class="small">@m.Note</td>
                    <td class="text-end text-nowrap">
                        @if (m.LeadId.HasValue && !m.CustomerId.HasValue) { <a class="btn btn-sm btn-outline-secondary" asp-controller="Leads" asp-action="Details" asp-route-id="@m.LeadId">Lead</a> }
                        @if (m.CustomerId.HasValue && m.Status != CampaignMemberStatus.Unsubscribed)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@m.CustomerId" asp-route-campaignId="@c.Id">@T("+ Cơ hội")</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Members.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted p-4">
                    @T("Chưa có đối tượng.")
                    @if (Model.CanEdit && c.IsOpen) { <a asp-action="Segment" asp-route-id="@c.Id">@T("Lập danh sách từ khách hàng / lead →")</a> }
                </td></tr>
            }
            </tbody>
        </table>
        </div>
    </form>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="small text-muted">@T("{0} đối tượng", Model.Members.TotalCount)</span>
        <partial name="_Pager" model="Model.Members" />
    </div>
</div>

@* ===== Kết quả: lead & cơ hội mang lại ===== *@
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">@Icon("lead") @T("Lead từ chiến dịch ({0})", s.Leads)</div>
            <div class="card-body p-0 table-responsive"><table class="table mb-0">
                <thead><tr><th>@T("Họ tên")</th><th>@T("Công ty")</th><th>@T("Trạng thái")</th><th>@T("Phụ trách")</th><th>@T("Ngày tạo")</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Leads)
                {
                    <tr><td>@if (User.CanAccess(l)) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@l.Id">@l.FullName</a> } else { @l.FullName }</td>
                        <td>@l.Company</td><td><partial name="_Badge" model="l.Status" /></td><td>@l.Owner?.FullName</td><td>@l.CreatedAt.ToDate()</td></tr>
                }
                @if (!Model.Leads.Any()) { <tr><td colspan="5" class="text-muted p-3">@T("Chưa có lead nào gắn với chiến dịch.")</td></tr> }
                </tbody>
            </table></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">@Icon("opportunity") @T("Cơ hội từ chiến dịch ({0})", s.Opportunities)</div>
            <div class="card-body p-0 table-responsive"><table class="table mb-0">
                <thead><tr><th>@T("Tên cơ hội")</th><th>@T("Khách hàng")</th><th>@T("Giai đoạn")</th><th class="money">@T("Giá trị")</th></tr></thead>
                <tbody>
                @foreach (var o in Model.Opportunities)
                {
                    <tr><td>@if (User.CanAccess(o)) { <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.Id">@o.Name</a> } else { @o.Name }</td>
                        <td>@o.Customer?.Name</td><td><partial name="_Badge" model="o.Stage" /></td><td class="money">@o.Amount.ToMoney()</td></tr>
                }
                @if (!Model.Opportunities.Any()) { <tr><td colspan="4" class="text-muted p-3">@T("Chưa có cơ hội nào gắn với chiến dịch.")</td></tr> }
                </tbody>
            </table></div>
        </div>
    </div>
</div>

<div class="mt-3">@await Component.InvokeAsync("Attachments", new { type = AttachmentTarget.Campaign, id = c.Id, hint = T("Banner, brochure, danh sách khách mời, báo cáo kết quả…") })</div>

@section Scripts {
<script>
    (function () {
        const form = document.getElementById('memberForm');
        if (!form) return;
        const boxes = () => Array.from(form.querySelectorAll('input[name="memberIds"]'));
        const all = form.querySelector('[data-check-all]');
        const counter = form.querySelector('[data-selection-count]');
        const en = document.documentElement.lang === 'en';
        function refresh() {
            const n = boxes().filter(b => b.checked).length;
            form.querySelectorAll('[data-need-selection]').forEach(b => b.disabled = n === 0);
            if (counter) counter.textContent = n ? (en ? n + ' selected' : 'Đã chọn ' + n) : '';
            if (all) { all.checked = n > 0 && n === boxes().length; all.indeterminate = n > 0 && n < boxes().length; }
        }
        if (all) all.addEventListener('change', () => { boxes().forEach(b => b.checked = all.checked); refresh(); });
        form.addEventListener('change', e => { if (e.target.name === 'memberIds') refresh(); });
        form.querySelectorAll('[data-confirm-click]').forEach(b => b.addEventListener('click', e => {
            if (!confirm(b.getAttribute('data-confirm-click'))) e.preventDefault();
        }));
        refresh();
    })();
    document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', async () => {
        const el = document.querySelector(b.getAttribute('data-copy'));
        try { await navigator.clipboard.writeText(el.innerText); const t = b.textContent; b.textContent = '✓'; setTimeout(() => b.textContent = t, 1200); } catch (e) { }
    }));
</script>
}
