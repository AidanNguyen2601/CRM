@model UiPrefs
@{
    ViewData["Title"] = T("Giao diện");
    var isCustom = (bool)ViewBag.IsCustom;
    string Chk(bool b) => b ? "checked" : "";
}
<form asp-action="Save" method="post" id="uiForm">
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header">@Icon("palette") @T("Màu chủ đạo")</div><div class="card-body">
            <div class="ui-swatches">
                @foreach (var c in UiPrefs.Swatches)
                {
                    <button type="button" class="ui-swatch @(c == Model.Accent ? "active" : "")" style="background:@c" data-color="@c" title="@c"></button>
                }
                <label class="ms-2 small d-flex align-items-center gap-2">@T("Màu khác:")
                    <input type="color" name="Accent" id="accent" value="@Model.Accent" class="form-control form-control-color p-1" style="width:46px;height:34px" /></label>
            </div>
        </div></div>

        <div class="card mb-3"><div class="card-header">@T("Chủ đề")</div><div class="card-body">
            <div class="ui-choice">
                @foreach (var (v, label) in new[] { ("light", T("Sáng")), ("dark", T("Tối")), ("auto", T("Theo hệ điều hành")) })
                {
                    <div><input type="radio" name="Theme" id="th-@v" value="@v" @Chk(Model.Theme == v) /><label for="th-@v"><div class="ui-mock th-@v"></div>@label</label></div>
                }
            </div>
        </div></div>

        <div class="card mb-3"><div class="card-header">@T("Vị trí menu")</div><div class="card-body">
            <div class="ui-choice">
                @foreach (var (v, label) in new[] { ("left", T("Bên trái")), ("right", T("Bên phải")), ("top", T("Phía trên")), ("bottom", T("Phía dưới")) })
                {
                    <div><input type="radio" name="Menu" id="mn-@v" value="@v" @Chk(Model.Menu == v) /><label for="mn-@v"><div class="ui-mock @v"><i></i></div>@label</label></div>
                }
            </div>
            <div class="form-text">@T("Trên màn hình nhỏ (điện thoại) menu luôn trượt ra từ cạnh màn hình. Menu trên / dưới: các nhóm chức năng hiện dạng thả xuống.")</div>
        </div></div>

        <div class="card mb-3"><div class="card-header">@T("Kiểu menu")</div><div class="card-body">
            <div class="ui-choice">
                @foreach (var (v, label) in new[] { ("dark", T("Tối")), ("light", T("Sáng")), ("accent", T("Theo màu chủ đạo")) })
                {
                    <div><input type="radio" name="Sidebar" id="sb-@v" value="@v" @Chk(Model.Sidebar == v) /><label for="sb-@v"><div class="ui-mock left sb-@v"><i></i></div>@label</label></div>
                }
            </div>
        </div></div>

        <div class="card mb-3"><div class="card-header">@T("Font chữ")</div><div class="card-body row g-3">
            <div class="col-md-8"><label class="form-label" for="font">@T("Font")</label>
                <select name="Font" id="font" class="form-select">
                    @foreach (var (k, f) in UiPrefs.Fonts)
                    {
                        <option value="@k" selected="@(k == Model.Font)" style="font-family:@f.Css.Replace("\"", "'")">@T(f.Label)</option>
                    }
                </select></div>
            <div class="col-md-4"><label class="form-label" for="fontSize">@T("Cỡ chữ")</label>
                <select name="FontSize" id="fontSize" class="form-select">
                    @foreach (var s in UiPrefs.FontSizes)
                    {
                        <option value="@s" selected="@(s == Model.FontSize)">@(s == 13 ? T("Nhỏ") : s == 14 ? T("Vừa (mặc định)") : s == 15 ? T("Lớn") : T("Rất lớn")) – @(s)px</option>
                    }
                </select></div>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3 position-sticky" style="top:16px"><div class="card-body">
            <p class="small text-muted">@T("Thay đổi được xem trước ngay trên trang này. Bấm lưu để áp dụng cho mọi trang.")</p>
            <p class="small">@(isCustom ? T("Bạn đang dùng giao diện riêng.") : T("Bạn đang dùng giao diện mặc định của hệ thống."))</p>
            <div class="d-grid gap-2">
                <button class="btn btn-primary" name="scope" value="me">@Icon("check") @T("Lưu cho tôi")</button>
                @if (isCustom)
                {
                    <button class="btn btn-outline-secondary" name="scope" value="reset">@Icon("undo") @T("Dùng giao diện mặc định")</button>
                }
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <hr class="my-2" />
                    <button class="btn btn-outline-primary" name="scope" value="default" data-confirm-click="@T("Đặt cấu hình này làm giao diện mặc định cho mọi người dùng chưa tự cấu hình?")">@Icon("users") @T("Lưu làm mặc định hệ thống")</button>
                    <div class="form-text">@T("Áp dụng cho người dùng chưa tự chọn giao diện riêng.")</div>
                }
            </div>
            <hr />
            <div class="small text-muted mb-1">@T("Xem trước thành phần")</div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-primary btn-sm">@T("Nút chính")</button>
                <button type="button" class="btn btn-outline-primary btn-sm">@T("Nút phụ")</button>
                <span class="badge bg-success">@T("Hoàn thành")</span>
                <a href="#" onclick="return false">@T("Liên kết")</a>
            </div>
            <div class="progress mt-2" style="height:6px"><div class="progress-bar" style="width:60%;background:var(--accent)"></div></div>
        </div></div>
    </div>
</div>
</form>
@section Scripts {
<script>
    // Xem trước trực tiếp: đổi thuộc tính / biến CSS trên thẻ html
    (function () {
        const r = document.documentElement, form = document.getElementById('uiForm');
        const fonts = @Json.Serialize(UiPrefs.Fonts.ToDictionary(x => x.Key, x => x.Value.Css));
        const hex = h => [1, 3, 5].map(i => parseInt(h.substr(i, 2), 16));
        const toHex = a => '#' + a.map(v => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0')).join('');
        function accent(c) {
            const [x, y, z] = hex(c);
            r.style.setProperty('--accent', c);
            r.style.setProperty('--accent-dark', toHex([x * .8, y * .8, z * .8]));
            r.style.setProperty('--accent-light', toHex([x + (255 - x) * .55, y + (255 - y) * .55, z + (255 - z) * .55]));
            r.style.setProperty('--accent-rgb', x + ',' + y + ',' + z);
            document.querySelectorAll('.ui-swatch').forEach(s => s.classList.toggle('active', s.dataset.color === c));
        }
        const val = n => (form.querySelector('[name="' + n + '"]:checked') || form.querySelector('[name="' + n + '"]')).value;
        function apply() {
            const theme = val('Theme');
            r.dataset.themePref = theme;
            r.dataset.theme = theme === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme;
            r.dataset.menu = val('Menu');
            r.dataset.sidebar = val('Sidebar');
            r.style.setProperty('--app-font', fonts[val('Font')]);
            r.style.fontSize = val('FontSize') + 'px';
            accent(document.getElementById('accent').value);
        }
        document.querySelectorAll('.ui-swatch').forEach(s => s.addEventListener('click', () => { document.getElementById('accent').value = s.dataset.color; apply(); }));
        form.addEventListener('change', apply);
        form.addEventListener('input', e => { if (e.target.id === 'accent') apply(); });
    })();
</script>
}
