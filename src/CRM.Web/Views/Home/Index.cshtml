@model DashboardViewModel
@{
    ViewData["Title"] = User.SeesAll() ? T("Dashboard kinh doanh") : T("Dashboard của tôi");
    var maxStage = Math.Max(1m, Model.Pipeline.Count > 0 ? Model.Pipeline.Max(p => p.Amount) : 1);
    var maxMonth = Math.Max(1m, Model.WonByMonth.Count > 0 ? Model.WonByMonth.Max(m => m.Amount) : 1);
    var maxSource = Math.Max(1, Model.LeadsBySource.Count > 0 ? Model.LeadsBySource.Max(s => s.Count) : 1);
}
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card stat"><div class="label">@Icon("trending", "stat-ico")@T("Pipeline đang mở")</div><div class="value">@Model.OpenPipeline.ToShortMoney()</div><div class="small text-muted">@T("{0} cơ hội · trọng số {1}", Model.OpenOpportunities, Model.WeightedPipeline.ToShortMoney())</div></div></div>
    <div class="col-md-3"><div class="card stat"><div class="label">@Icon("trophy", "stat-ico")@T("Doanh số thắng tháng này")</div><div class="value text-success">@Model.WonThisMonth.ToShortMoney()</div><div class="small text-muted">@T("{0} hợp đồng · tỷ lệ thắng {1}%", Model.WonCountThisMonth, Model.WinRate)</div></div></div>
    <div class="col-md-3"><div class="card stat"><div class="label">@Icon("lead", "stat-ico")@T("Lead mới (30 ngày)")</div><div class="value">@Model.NewLeads30d</div><div class="small text-muted">@T("Tỷ lệ chuyển đổi {0}%", Model.LeadConversionRate)</div></div></div>
    <div class="col-md-3"><div class="card stat"><div class="label">@Icon("alert", "stat-ico")@T("Hoạt động quá hạn")</div><div class="value @(Model.OverdueActivities > 0 ? "text-danger" : "")">@Model.OverdueActivities</div><a class="small" asp-controller="Activities" asp-action="Index" asp-route-view="overdue">@T("Xem danh sách →")</a></div></div>
</div>

@if (ViewBag.Kpi is KpiRow kpi)
{
    var kp = (KpiPeriod)ViewBag.KpiPeriod;
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between">
            <span>@Icon("trending") @(User.SeesAll() ? T("KPI tháng {0} – toàn đội", kp.FromMonth) : T("KPI tháng {0} của tôi", kp.FromMonth))
                <span class="small text-muted fw-normal ms-2">@T("Đã qua {0}% thời gian", (kp.Elapsed * 100).ToString("0"))</span></span>
            <a class="small fw-normal" asp-controller="Kpi" asp-action="Index">@T("Xem bảng KPI →")</a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var m in Enum.GetValues<KpiMetric>())
                {
                    <div class="col-6 col-md">
                        <div class="small text-muted mb-1">@Icon(KpiUi.Icon(m)) @m.GetDisplayName()</div>
                        <partial name="~/Views/Kpi/_KpiCell.cshtml" model="(kpi, m, kp.Elapsed)" />
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between"><span>@Icon("pipeline") @T("Pipeline theo giai đoạn")</span> <a class="small fw-normal" asp-controller="Opportunities" asp-action="Pipeline">@T("Mở Kanban")</a></div>
            <div class="card-body">
                @foreach (var s in Model.Pipeline)
                {
                    <div class="bar-row">
                        <div class="lbl">@s.Stage.GetDisplayName() <span class="text-muted">(@s.Count)</span></div>
                        <div class="bar"><div style="width:@((int)(s.Amount * 100 / maxStage))%"></div></div>
                        <div class="val">@s.Amount.ToShortMoney()</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@Icon("trophy") @T("Doanh số thắng 6 tháng gần nhất")</div>
            <div class="card-body">
                <div class="cols">
                    @foreach (var m in Model.WonByMonth)
                    {
                        <div class="col-item">
                            <div class="v">@(m.Amount > 0 ? m.Amount.ToShortMoney() : "")</div>
                            <div class="colbar" style="height:@((int)(m.Amount * 140 / maxMonth))px"></div>
                            <div class="mt-1 text-muted">@m.Month</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">@Icon("opportunity") @T("Cơ hội dự kiến chốt trong 30 ngày")</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>@T("Cơ hội")</th><th>@T("Giai đoạn")</th><th class="money">@T("Giá trị")</th><th>@T("Dự kiến chốt")</th></tr></thead>
                    <tbody>
                    @foreach (var o in Model.ClosingSoon)
                    {
                        <tr>
                            <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.Id">@o.Name</a><br /><small class="text-muted">@o.Customer?.Name</small></td>
                            <td><partial name="_Badge" model="o.Stage" /></td>
                            <td class="money">@o.Amount.ToMoney()</td>
                            <td class="@(o.ExpectedCloseDate < DateTime.Today ? "text-danger" : "")">@o.ExpectedCloseDate.ToDate()</td>
                        </tr>
                    }
                    @if (!Model.ClosingSoon.Any()) { <tr><td colspan="4" class="text-muted p-3">@T("Không có.")</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header">@Icon("lead") @T("Lead theo nguồn")</div>
            <div class="card-body">
                @foreach (var s in Model.LeadsBySource)
                {
                    <div class="bar-row">
                        <div class="lbl">@s.Source</div>
                        <div class="bar"><div style="width:@(s.Count * 100 / maxSource)%"></div></div>
                        <div class="val" style="width:40px">@s.Count</div>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex justify-content-between"><span>@Icon("calendar") @T("Việc cần làm")</span> <a class="small fw-normal" asp-controller="Activities" asp-action="Index">@T("Tất cả")</a></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                    @foreach (var a in Model.UpcomingActivities)
                    {
                        <tr class="@(a.IsOverdue ? "table-danger" : "")">
                            <td class="text-nowrap small">@a.DueDate.ToString("dd/MM HH:mm")</td>
                            <td><span class="act-type">@Icon(ForActivity(a.Type))@a.Type.GetDisplayName()</span><a asp-controller="Activities" asp-action="Edit" asp-route-id="@a.Id">@a.Subject</a><br /><small class="text-muted">@(a.Customer?.Name ?? a.Lead?.FullName)</small></td>
                        </tr>
                    }
                    @if (!Model.UpcomingActivities.Any()) { <tr><td class="text-muted p-3">@T("Không có việc đang chờ.")</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
