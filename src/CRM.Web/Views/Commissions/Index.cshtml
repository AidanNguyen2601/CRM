@model List<CRM.Web.Controllers.CommissionRow>
@using CRM.Web.Controllers
@{
    var p = (KpiPeriod)ViewBag.P;
    var period = (string)ViewBag.Period;
    var s = (CommissionSettings)ViewBag.Settings;
    var years = (int[])ViewBag.Years;
    ViewData["Title"] = T("Hoa hồng kinh doanh");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<form method="get" class="toolbar align-items-end">
    <div class="btn-group">
        @foreach (var (key, text) in new[] { ("month", T("Tháng")), ("quarter", T("Quý")), ("year", T("Năm")) })
        {
            <a class="btn btn-outline-primary @(period == key ? "active" : "")" asp-route-period="@key" asp-route-year="@p.Year">@text</a>
        }
    </div>
    <input type="hidden" name="period" value="@period" />
    <div><label class="form-label small mb-1">@T("Năm")</label><select name="year" class="form-select" onchange="this.form.submit()">@foreach (var y in years) { <option value="@y" selected="@(y == p.Year)">@y</option> }</select></div>
    @if (period == "month") { <div><label class="form-label small mb-1">@T("Tháng")</label><select name="month" class="form-select" onchange="this.form.submit()">@for (var i = 1; i <= 12; i++) { <option value="@i" selected="@(i == p.FromMonth)">@T("Tháng {0}", i)</option> }</select></div> }
    else if (period == "quarter") { <div><label class="form-label small mb-1">@T("Quý")</label><select name="quarter" class="form-select" onchange="this.form.submit()">@for (var i = 1; i <= 4; i++) { <option value="@i" selected="@(i == (p.FromMonth - 1) / 3 + 1)">@T("Quý {0}", i)</option> }</select></div> }
    <a class="btn btn-outline-secondary ms-auto" asp-action="Export" asp-route-period="@period" asp-route-year="@p.Year" asp-route-month="@p.FromMonth" asp-route-quarter="@((p.FromMonth - 1) / 3 + 1)">@Icon("download") @T("Xuất Excel")</a>
</form>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>@T("Nhân viên")</th><th class="money">@(s.Basis == "revenue" ? T("Doanh số (cơ sở tính)") : T("Tiền đã thu (cơ sở tính)"))</th><th class="text-center">@T("% hoàn thành chỉ tiêu doanh số")</th><th class="text-center">@T("Tỷ lệ")</th><th class="money">@T("Hoa hồng")</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><a asp-controller="Kpi" asp-action="Member" asp-route-id="@r.User.Id" asp-route-year="@p.Year">@r.User.FullName</a></td>
                        <td class="money">@r.Basis.ToMoney()</td>
                        <td class="text-center">@(r.Target > 0 ? r.Attainment.ToString("0.#") + "%" : T("Chưa giao"))<div class="small text-muted">@r.Revenue.ToShortMoney() / @(r.Target > 0 ? r.Target.ToShortMoney() : "–")</div></td>
                        <td class="text-center"><span class="badge bg-primary">@r.Rate.ToString("0.##")%</span></td>
                        <td class="money fw-semibold">@r.Amount.ToMoney()</td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted p-4">@T("Không có nhân viên kinh doanh.")</td></tr> }
                </tbody>
                <tfoot><tr class="fw-semibold"><td>@T("Tổng")</td><td class="money">@Model.Sum(r => r.Basis).ToMoney()</td><td></td><td></td><td class="money">@Model.Sum(r => r.Amount).ToMoney()</td></tr></tfoot>
            </table>
        </div></div>
        <p class="small text-muted mt-2">@T("Kỳ {0} – {1}. Hoa hồng = cơ sở tính × tỷ lệ theo bậc % hoàn thành chỉ tiêu doanh số của kỳ (số liệu từ KPI bán hàng).", p.Start.ToDate(), p.End.AddDays(-1).ToDate())</p>
    </div>
    <div class="col-lg-4">
        <form asp-action="Settings" method="post" class="card"><div class="card-header">@T("Chính sách hoa hồng")</div><div class="card-body">
            <label class="form-label small">@T("Cơ sở tính")</label>
            <select name="basis" class="form-select form-select-sm mb-3" @(User.IsInRole(AppRoles.Admin) ? "" : "disabled")>
                <option value="collection" selected="@(s.Basis == "collection")">@T("Tiền đã thu trong kỳ")</option>
                <option value="revenue" selected="@(s.Basis == "revenue")">@T("Doanh số (cơ hội thắng) trong kỳ")</option>
            </select>
            <table class="table table-sm mb-2" data-no-grid id="tiers">
                <thead><tr><th>@T("Từ % hoàn thành")</th><th>@T("Tỷ lệ (%)")</th></tr></thead>
                <tbody>
                @foreach (var t in s.Tiers.Concat(new[] { new CommissionTier { FromPercent = -1 } }))
                {
                    <tr><td><input name="from" type="number" step="1" min="0" value="@(t.FromPercent < 0 ? "" : t.FromPercent.ToString(inv))" class="form-control form-control-sm" /></td>
                        <td><input name="rate" type="number" step="0.1" min="0" max="100" value="@(t.FromPercent < 0 ? "" : t.Rate.ToString(inv))" class="form-control form-control-sm" /></td></tr>
                }
                </tbody>
            </table>
            <div class="form-text mb-2">@T("Dòng trống được bỏ qua. Nhân viên chưa được giao chỉ tiêu áp bậc thấp nhất.")</div>
            @if (User.IsInRole(AppRoles.Admin)) { <button class="btn btn-sm btn-primary">@T("Lưu chính sách")</button> }
        </div></form>
    </div>
</div>
