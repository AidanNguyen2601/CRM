@model PagedList<Lead>
@{
    ViewData["Title"] = T("Lead – khách hàng tiềm năng");
    var f = (LeadFilter)ViewBag.Filter;
    var statusItems = Html.GetEnumSelectList<LeadStatus>().ToList();
    foreach (var i in statusItems) i.Selected = f.Status.HasValue && i.Value == ((int)f.Status.Value).ToString();
    var sourceItems = Html.GetEnumSelectList<LeadSource>().ToList();
    foreach (var i in sourceItems) i.Selected = f.Source.HasValue && i.Value == ((int)f.Source.Value).ToString();
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Tên, công ty, email, SĐT")" /></div>
    <div><label class="form-label small mb-1">@T("Trạng thái")</label><select name="Status" class="form-select" asp-items="statusItems"><option value="">@T("Đang theo đuổi")</option></select></div>
    <div><label class="form-label small mb-1">@T("Nguồn")</label><select name="Source" class="form-select" asp-items="sourceItems"><option value="">@T("-- Tất cả --")</option></select></div>
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div> }
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Thêm lead")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Họ tên")</th><th>@T("Công ty")</th><th>@T("Liên hệ")</th><th>@T("Nguồn")</th><th>@T("Mức độ")</th><th class="money">@T("Giá trị dự kiến")</th><th>@T("Trạng thái")</th><th>@T("Phụ trách")</th><th>@T("Ngày tạo")</th></tr></thead>
    <tbody>
    @foreach (var l in Model.Items)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@l.Id" class="fw-semibold">@l.FullName</a><br /><small class="text-muted">@l.JobTitle</small></td>
            <td>@l.Company</td>
            <td class="small">@l.Phone<br />@l.Email</td>
            <td>@l.Source.GetDisplayName()</td>
            <td><partial name="_Badge" model="l.Rating" /></td>
            <td class="money">@l.EstimatedValue.ToMoney()</td>
            <td><partial name="_Badge" model="l.Status" /></td>
            <td>@l.Owner?.FullName</td>
            <td>@l.CreatedAt.ToDate()</td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="9" class="text-center text-muted p-4">@T("Không có lead.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">@T("Tổng: {0} lead", Model.TotalCount)</span>
    <partial name="_Pager" model="Model" />
</div></div>
