@{
    ViewData["Title"] = T("Xác thực 2 lớp");
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h4 class="mb-1 fw-bold">@T("Xác thực 2 lớp")</h4>
    <p class="text-muted mb-4">@T("Mở ứng dụng Authenticator trên điện thoại và nhập mã 6 số đang hiển thị cho CRM.")</p>
    <form asp-action="LoginTwoFactor" method="post" autocomplete="off">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <input name="code" class="form-control otp-input mb-3" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" autofocus required placeholder="000000" autocomplete="one-time-code" />
        <button class="btn btn-primary w-100">@T("Xác nhận")</button>
    </form>
    <div class="mt-3 small"><a asp-action="Login">← @T("Đăng nhập bằng tài khoản khác")</a></div>
    <div class="mt-2 small text-muted">@T("Mất điện thoại? Liên hệ quản trị để tắt xác thực 2 lớp cho tài khoản.")</div>
</div>
