@model string?
@{
    ViewData["Title"] = T("Đặt lại mật khẩu");
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h4 class="mb-1 fw-bold">@T("Đặt lại mật khẩu")</h4>
    @if (Model == null)
    {
        <p class="text-muted">@T("Liên kết đặt lại mật khẩu không hợp lệ, đã được dùng hoặc đã hết hạn.")</p>
        <a class="btn btn-primary w-100" asp-action="ForgotPassword">@T("Gửi lại liên kết")</a>
    }
    else
    {
        <form asp-action="ResetPassword" method="post" autocomplete="off">
            <input type="hidden" name="token" value="@Model" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3"><label class="form-label">@T("Mật khẩu mới")</label><input type="password" name="newPassword" class="form-control" required autofocus autocomplete="new-password" /></div>
            <div class="mb-2"><label class="form-label">@T("Xác nhận mật khẩu mới")</label><input type="password" name="confirmPassword" class="form-control" required autocomplete="new-password" /></div>
            <div class="form-text mb-3">@ViewBag.Policy</div>
            <button class="btn btn-primary w-100">@T("Đặt mật khẩu mới")</button>
        </form>
    }
    <div class="mt-3 small"><a asp-action="Login">← @T("Quay lại đăng nhập")</a></div>
</div>
