@model LoginViewModel
@{
    ViewData["Title"] = T("Đăng nhập");
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h3 class="mb-1 fw-bold">CRM System</h3>
    <p class="text-muted mb-4">@T("Đăng nhập để tiếp tục")</p>
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autofocus />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button class="btn btn-primary w-100">@T("Đăng nhập")</button>
    </form>
    <div class="text-end mt-2"><a class="small" asp-action="ForgotPassword">@T("Quên mật khẩu?")</a></div>
    <div class="mt-4 small text-muted">
        @T("Tài khoản demo:") <b>admin</b>/Admin@@123 · <b>manager</b>/Manager@@123 · <b>sales1</b>/Sales@@123 · <b>sales2</b>/Sales@@123
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
