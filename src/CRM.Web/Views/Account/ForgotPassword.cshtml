@{
    ViewData["Title"] = T("Quên mật khẩu");
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h4 class="mb-1 fw-bold">@T("Quên mật khẩu")</h4>
    <p class="text-muted mb-4">@T("Nhập tên đăng nhập hoặc email của bạn. Hệ thống sẽ gửi liên kết đặt lại mật khẩu tới email đã đăng ký.")</p>
    <form asp-action="ForgotPassword" method="post">
        <div class="mb-3"><label class="form-label">@T("Tên đăng nhập hoặc email")</label><input name="login" class="form-control" required autofocus /></div>
        <button class="btn btn-primary w-100">@T("Gửi liên kết đặt lại")</button>
    </form>
    <div class="mt-3 small"><a asp-action="Login">← @T("Quay lại đăng nhập")</a></div>
</div>
