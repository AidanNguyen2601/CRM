@model PagedList<Customer>
@{
    ViewData["Title"] = T("Khách hàng");
    var f = (CustomerFilter)ViewBag.Filter;
    var won = (Dictionary<int, decimal>)ViewBag.Won;
    var typeItems = Html.GetEnumSelectList<CustomerType>().ToList();
    foreach (var i in typeItems) i.Selected = f.Type.HasValue && i.Value == ((int)f.Type.Value).ToString();
    Func<int, string> pageUrl = p => Url.Action("Index", new { f.Keyword, f.Type, f.OwnerId, Page = p })!;
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Tên, mã, MST, SĐT, email")" /></div>
    <div><label class="form-label small mb-1">@T("Phân loại")</label><select name="Type" class="form-select" asp-items="typeItems"><option value="">@T("-- Tất cả --")</option></select></div>
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div> }
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Thêm khách hàng")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Mã")</th><th>@T("Tên khách hàng")</th><th>@T("Ngành")</th><th>@T("Tỉnh/TP")</th><th>@T("Liên hệ")</th><th>@T("Phân loại")</th><th class="money">@T("Doanh số đã thắng")</th><th>@T("Phụ trách")</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@c.Code</td>
            <td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold">@c.Name</a></td>
            <td>@Catalogs.Text(CatalogGroup.Industry, c.Industry)</td>
            <td>@Catalogs.Text(CatalogGroup.City, c.City)</td>
            <td class="small">@c.Phone<br />@c.Email</td>
            <td><partial name="_Badge" model="c.Type" /></td>
            <td class="money">@(won.TryGetValue(c.Id, out var w) ? w.ToMoney() : "")</td>
            <td>@c.Owner?.FullName</td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted p-4">@T("Không có khách hàng.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">@T("Tổng: {0} khách hàng", Model.TotalCount)</span>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages, pageUrl)" />
</div></div>
