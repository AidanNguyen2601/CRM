@* Dòng thời gian hợp nhất của khách hàng 360°, nhóm theo tháng. data-kind dùng để lọc (care/sales/finance/marketing) *@
@model List<TimelineEvent>
@if (!Model.Any())
{
    <div class="text-muted p-3">@T("Chưa có dữ liệu.")</div>
}
<ul class="timeline c360-tl">
@{ string? month = null; }
@foreach (var e in Model)
{
    var key = e.When.ToString("MM/yyyy");
    if (key != month)
    {
        month = key;
        <li class="tl-month">@T("Tháng {0}", key)</li>
    }
    <li class="@e.Css" data-kind="@e.Kind">
        <div class="d-flex justify-content-between gap-2">
            <div>
                <span class="act-type k-@e.Kind">@Icon(e.Icon)</span>
                @if (e.Controller != null && e.Id.HasValue)
                {
                    <a asp-controller="@e.Controller" asp-action="@e.Action" asp-route-id="@e.Id" class="fw-semibold">@e.Title</a>
                }
                else { <span class="fw-semibold">@e.Title</span> }
                <div class="small text-muted">@(e.When.TimeOfDay == TimeSpan.Zero ? e.When.ToDate() : e.When.ToDateTime())@(string.IsNullOrEmpty(e.Detail) ? "" : " · " + e.Detail)</div>
            </div>
            @if (e.Amount is decimal amt && amt != 0) { <div class="money small fw-semibold">@amt.ToMoney()</div> }
        </div>
    </li>
}
</ul>
