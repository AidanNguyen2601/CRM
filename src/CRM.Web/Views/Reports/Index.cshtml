@using CRM.Web.Infrastructure.Reports
@{
    ViewData["Title"] = T("Báo cáo");
    var standard = (IReadOnlyList<ReportDefinition>)ViewBag.Standard;
    var custom = (List<CustomReport>)ViewBag.Custom;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var grants = (Dictionary<string, ReportGrant>)ViewBag.Grants;
    string ScopeBadge(string key) => grants.TryGetValue(key, out var g) ? g.Scope.GetDisplayName() + (g.CanExport ? "" : " · " + T("không xuất Excel")) : "";
}
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h5 class="mb-0">@Icon("trending") @T("Báo cáo chuẩn")</h5>
    <div class="d-flex gap-2">
        @if (User.SeesAll()) { <a class="btn btn-outline-primary" asp-controller="ReportSchedules" asp-action="Index">@Icon("clock") @T("Gửi báo cáo định kỳ")</a> }
        @if (isAdmin) { <a class="btn btn-outline-primary" asp-action="Access">@Icon("key") @T("Phân quyền báo cáo")</a> }
    </div>
</div>
<div class="row g-3 mb-4">
    @foreach (var g in standard.GroupBy(r => r.Group))
    {
        <div class="col-lg-6 col-xl-3">
            <div class="card h-100">
                <div class="card-header fw-semibold">@g.Key</div>
                <div class="list-group list-group-flush">
                    @foreach (var r in g)
                    {
                        <a class="list-group-item list-group-item-action report-link" asp-action="Run" asp-route-id="@r.Key">
                            <div class="d-flex gap-2 align-items-start">
                                @Icon(r.Icon, "report-ico")
                                <div><div class="fw-semibold">@r.Title</div><div class="small text-muted">@r.Description</div>
                                    <div class="small mt-1"><span class="badge text-bg-light border">@Icon("key") @ScopeBadge(ReportAccessService.StdKey(r.Key))</span></div></div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h5 class="mb-0">@Icon("receivable") @T("Báo cáo động")</h5>
    @if (isAdmin)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="CustomCreate" asp-route-source="Sql">@Icon("plus") @T("Báo cáo từ câu lệnh SQL")</a>
            <a class="btn btn-outline-primary" asp-action="CustomCreate" asp-route-source="View">@Icon("plus") @T("Báo cáo từ View")</a>
        </div>
    }
</div>
@if (!custom.Any())
{
    <div class="card"><div class="card-body text-muted">@T("Chưa có báo cáo động nào.") @if (isAdmin) { @T("Bấm nút phía trên để tạo báo cáo từ câu lệnh SQL hoặc từ View.") }</div></div>
}
else
{
    <div class="card"><div class="card-body p-0">
    <table class="table table-hover mb-0" data-grid="custom-reports">
        <thead><tr><th>@T("Tên báo cáo")</th><th>@T("Nhóm")</th><th>@T("Nguồn dữ liệu")</th><th>@T("Vai trò được xem")</th>@if (isAdmin) { <th>@T("Trạng thái")</th><th></th> }</tr></thead>
        <tbody>
        @foreach (var r in custom)
        {
            <tr class="@(r.IsActive ? "" : "text-muted")">
                <td><a asp-action="Custom" asp-route-id="@r.Id" class="fw-semibold">@r.Name</a>
                    @if (!string.IsNullOrEmpty(r.Description)) { <div class="small text-muted">@r.Description</div> }
                    <div class="small mt-1"><span class="badge text-bg-light border">@Icon("key") @ScopeBadge(ReportAccessService.CustomKey(r.Id))</span></div></td>
                <td>@r.Category</td>
                <td><span class="badge @(r.SourceType == CustomReportSource.Sql ? "bg-dark" : r.SourceType == CustomReportSource.Builder ? "bg-success" : "bg-info text-dark")">@r.SourceType.GetDisplayName()</span>
                    @if (r.SourceType == CustomReportSource.View) { <div class="small text-muted">@r.ViewName</div> }</td>
                <td class="small">@string.Join(", ", r.AllowedRoles.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => AppRoles.DisplayName(x.Trim())))</td>
                @if (isAdmin)
                {
                    <td>@(r.IsActive ? Html.Raw($"<span class='badge bg-success'>{T("Đang sử dụng")}</span>") : Html.Raw($"<span class='badge bg-secondary'>{T("Ngừng sử dụng")}</span>"))</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="CustomEdit" asp-route-id="@r.Id">@T("Sửa")</a>
                        <form asp-action="CustomDelete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirm="@T("Xóa báo cáo {0}?", r.Name)"><button class="btn btn-sm btn-outline-danger">@T("Xóa")</button></form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    </div></div>
}
