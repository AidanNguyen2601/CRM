@using CRM.Web.Infrastructure.Reports
@model CRM.Web.Controllers.ReportPageModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["GridKey"] = Model.Custom != null ? $"report-custom-{Model.Custom.Id}" : $"report-{ViewContext.RouteData.Values["id"]}";
    var f = Model.Filter;
    var fl = Model.Filters;
    var years = Enumerable.Range(DateTime.Today.Year - 4, 6).Reverse();
    // Giữ bộ lọc hiện tại cho nút xuất Excel
    var q = Context.Request.QueryString.Value ?? "";
    var exportUrl = Url.Action(Model.ExportAction, Model.RouteValues) + q;
}
<div class="d-flex justify-content-between align-items-start gap-3 mb-2 no-print">
    <div>
        <a asp-action="Index" class="small">← @T("Tất cả báo cáo")</a>
        @if (!string.IsNullOrEmpty(Model.Description)) { <div class="text-muted small mt-1">@Model.Description</div> }
        @if (!string.IsNullOrEmpty(Model.ScopeText))
        {
            <div class="small mt-1"><span class="badge text-bg-light border" title="@T("Theo: {0}", Model.Grant?.Source ?? "")">@Icon("key") @T("Vùng dữ liệu: {0}", Model.ScopeText)</span></div>
        }
    </div>
    @if (Model.Custom != null && User.IsInRole(AppRoles.Admin))
    {
        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="CustomEdit" asp-route-id="@Model.Custom.Id">@T("Sửa báo cáo")</a>
    }
</div>

<form method="get" class="toolbar no-print">
    @if (fl.HasFlag(ReportFilters.Period))
    {
        <div><label class="form-label small mb-1">@T("Từ ngày")</label><input type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label small mb-1">@T("Đến ngày")</label><input type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="d-flex gap-1 mb-1 flex-wrap period-quick">
            @{ var t = DateTime.Today; var ms = new DateTime(t.Year, t.Month, 1); var qs = new DateTime(t.Year, (t.Month - 1) / 3 * 3 + 1, 1); }
            @foreach (var (label, a, b) in new[] { (T("Tháng này"), ms, t), (T("Tháng trước"), ms.AddMonths(-1), ms.AddDays(-1)), (T("Quý này"), qs, t),
                                                    (T("Năm nay"), new DateTime(t.Year, 1, 1), t), (T("Năm trước"), new DateTime(t.Year - 1, 1, 1), new DateTime(t.Year - 1, 12, 31)) })
            {
                <button type="button" class="btn btn-sm btn-light" data-from="@a.ToString("yyyy-MM-dd")" data-to="@b.ToString("yyyy-MM-dd")">@label</button>
            }
        </div>
    }
    @if (fl.HasFlag(ReportFilters.Year))
    {
        <div><label class="form-label small mb-1">@T("Năm")</label>
            <select name="Year" class="form-select">@foreach (var y in years) { <option value="@y" selected="@(y == f.YearValue)">@y</option> }</select></div>
    }
    @if (fl.HasFlag(ReportFilters.Owner) && Model.ShowOwnerFilter)
    {
        <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div>
    }
    @if (fl.HasFlag(ReportFilters.Top))
    {
        <div><label class="form-label small mb-1">Top</label>
            <select name="Top" class="form-select">@foreach (var n in new[] { 10, 20, 50, 100, 500 }) { <option value="@n" selected="@(n == f.Top)">@n</option> }</select></div>
    }
    @if (fl.HasFlag(ReportFilters.Days))
    {
        <div><label class="form-label small mb-1">@T("Trong (ngày tới)")</label>
            <select name="Days" class="form-select">@foreach (var n in new[] { 30, 60, 90, 180, 365 }) { <option value="@n" selected="@(n == f.Days)">@n</option> }</select></div>
    }
    @if (fl.HasFlag(ReportFilters.Keyword))
    {
        <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" /></div>
    }
    @if (fl != ReportFilters.None) { <button class="btn btn-outline-primary">@T("Xem báo cáo")</button> }
    <div class="ms-auto d-flex gap-2">
        @if (Model.Result != null)
        {
            @if (Model.Grant?.CanExport != false) { <a class="btn btn-success" href="@exportUrl">@Icon("download") @T("Xuất Excel")</a> }
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">@T("In")</button>
        }
    </div>
</form>

<div class="print-only mb-2">
    <h4 class="mb-0">@Model.Title</h4>
    <div class="small text-muted">
        @if (fl.HasFlag(ReportFilters.Period)) { <span>@T("Kỳ: {0} – {1}", f.FromDate.ToDate(), f.ToExclusive.AddDays(-1).ToDate())</span> }
        @if (fl.HasFlag(ReportFilters.Year)) { <span>@T("Năm {0}", f.YearValue)</span> }
        · @T("In lúc {0}", DateTime.Now.ToString("dd/MM/yyyy HH:mm"))
    </div>
</div>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
@if (Model.Result != null) { <partial name="_ReportTable" model="Model.Result" /> }

@if (Model.Sql != null && User.IsInRole(AppRoles.Admin))
{
    <details class="mt-3 no-print"><summary class="small text-muted">@T("Câu lệnh SQL của báo cáo (chỉ quản trị thấy)")</summary><pre class="report-sql">@Model.Sql</pre></details>
}

@section Scripts {
<script>
    // Nút chọn nhanh kỳ báo cáo
    document.querySelectorAll('.period-quick [data-from]').forEach(b => b.addEventListener('click', () => {
        const form = b.closest('form');
        form.querySelector('[name=From]').value = b.dataset.from;
        form.querySelector('[name=To]').value = b.dataset.to;
        form.submit();
    }));
</script>
}
