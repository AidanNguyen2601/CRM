@model KbArticle
@{
    ViewData["Title"] = Model.Title;
    var related = (List<KbArticle>)ViewBag.Related;
}
<div class="toolbar">
    <a class="btn btn-light" asp-action="Index">← @T("Kho kiến thức")</a>
    @if ((bool)ViewBag.CanEdit)
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">@T("Sửa")</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ms-auto" data-confirm="@T("Xóa bài viết \"{0}\"?", Model.Title)"><button class="btn btn-outline-danger">@T("Xóa")</button></form>
    }
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <h4>@Model.Title</h4>
        <div class="small text-muted mb-3">
            @Catalogs.Text(CatalogGroup.TicketCategory, Model.Category) · @T("Cập nhật {0}", Model.UpdatedAt.ToDate()) · @Model.Author?.FullName · @T("{0} lượt xem", Model.Views)
            @if (Model.IsTemplate) { <span class="badge bg-info text-dark">@T("Mẫu trả lời")</span> }
            @if (Model.IsPublic) { <span class="badge bg-success">@T("Công khai")</span> }
        </div>
        <div class="kb-body">@Model.Body</div>
        <hr />
        <form asp-action="Vote" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 small">
            <span>@T("Bài viết có hữu ích không?")</span>
            <button name="helpful" value="true" class="btn btn-sm btn-outline-success">👍 @Model.Helpful</button>
            <button name="helpful" value="false" class="btn btn-sm btn-outline-secondary">👎 @Model.NotHelpful</button>
        </form>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-header">@T("Bài viết liên quan")</div>
        <ul class="list-group list-group-flush">
            @foreach (var r in related) { <li class="list-group-item"><a asp-action="Details" asp-route-id="@r.Id">@r.Title</a></li> }
            @if (!related.Any()) { <li class="list-group-item small text-muted">@T("Không có.")</li> }
        </ul>
    </div></div>
</div>
