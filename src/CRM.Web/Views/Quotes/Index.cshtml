@model List<Quote>
@{
    ViewData["Title"] = "Báo giá";
    var status = ViewBag.Status as QuoteStatus?;
    var statusItems = Html.GetEnumSelectList<QuoteStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">Tìm kiếm</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Số báo giá, khách hàng" /></div>
    <div><label class="form-label small mb-1">Trạng thái</label><select name="status" class="form-select" asp-items="statusItems"><option value="">-- Tất cả --</option></select></div>
    <button class="btn btn-outline-primary">Lọc</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">+ Tạo báo giá</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>Số báo giá</th><th>Khách hàng</th><th>Ngày</th><th>Hiệu lực đến</th><th class="money">Tổng thanh toán</th><th>Trạng thái</th><th>Phụ trách</th></tr></thead>
    <tbody>
    @foreach (var q in Model)
    {
        var expired = q.Status is QuoteStatus.Draft or QuoteStatus.Sent && q.ValidUntil < DateTime.Today;
        <tr>
            <td><a asp-action="Details" asp-route-id="@q.Id" class="fw-semibold">@q.Number</a></td>
            <td>@q.Customer?.Name</td>
            <td>@q.QuoteDate.ToDate()</td>
            <td class="@(expired ? "text-danger" : "")">@q.ValidUntil.ToDate() @if (expired) { <small>(hết hạn)</small> }</td>
            <td class="money">@q.Total.ToMoney()</td>
            <td><partial name="_Badge" model="q.Status" /></td>
            <td>@q.Owner?.FullName</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted p-4">Chưa có báo giá.</td></tr> }
    </tbody>
</table>
</div></div>
