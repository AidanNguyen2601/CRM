@model List<Quote>
@{
    ViewData["Title"] = T("Báo giá");
    var status = ViewBag.Status as QuoteStatus?;
    var statusItems = Html.GetEnumSelectList<QuoteStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="@T("Số báo giá, khách hàng")" /></div>
    <div><label class="form-label small mb-1">@T("Trạng thái")</label><select name="status" class="form-select" asp-items="statusItems"><option value="">@T("-- Tất cả --")</option></select></div>
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Tạo báo giá")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Số báo giá")</th><th>@T("Khách hàng")</th><th>@T("Ngày")</th><th>@T("Hiệu lực đến")</th><th class="money">@T("Tổng thanh toán")</th><th>@T("Trạng thái")</th><th>@T("Phụ trách")</th></tr></thead>
    <tbody>
    @foreach (var q in Model)
    {
        var expired = q.Status is QuoteStatus.Draft or QuoteStatus.Sent && q.ValidUntil < DateTime.Today;
        <tr>
            <td><a asp-action="Details" asp-route-id="@q.Id" class="fw-semibold">@q.Number</a></td>
            <td>@q.Customer?.Name</td>
            <td>@q.QuoteDate.ToDate()</td>
            <td class="@(expired ? "text-danger" : "")">@q.ValidUntil.ToDate() @if (expired) { <small>@T("(hết hạn)")</small> }</td>
            <td class="money">@q.Total.ToMoney()</td>
            <td><partial name="_Badge" model="q.Status" /></td>
            <td>@q.Owner?.FullName</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted p-4">@T("Chưa có báo giá.")</td></tr> }
    </tbody>
</table>
</div></div>
