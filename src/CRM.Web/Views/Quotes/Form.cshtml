@model QuoteFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? T("Tạo báo giá") : T("Sửa báo giá {0}", Model.Number); }
<form asp-action="Save" method="post" id="quoteForm">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-3"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        <div class="col-md-5"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" data-contacts-for="#ContactId"><option value="">@T("-- Chọn khách hàng --")</option></select><span asp-validation-for="CustomerId" class="text-danger small"></span><div class="form-text text-primary" id="priceListNote"></div></div>
        <div class="col-md-4"><label asp-for="ContactId" class="form-label"></label><select asp-for="ContactId" class="form-select" asp-items="ViewBag.Contacts"><option value="">@T("-- Chọn --")</option></select></div>
        <div class="col-md-4"><label asp-for="OpportunityId" class="form-label"></label><select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities"><option value="">@T("-- Không --")</option></select></div>
        <div class="col-md-2"><label asp-for="QuoteDate" class="form-label"></label><input asp-for="QuoteDate" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="ValidUntil" class="form-label"></label><input asp-for="ValidUntil" class="form-control" /><span asp-validation-for="ValidUntil" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="DiscountPercent" class="form-label"></label><input asp-for="DiscountPercent" class="form-control calc" /></div>
        <div class="col-md-2"><label asp-for="VatPercent" class="form-label"></label><select asp-for="VatPercent" class="form-select calc"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="10">10%</option></select></div>
    </div></div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">@T("Chi tiết sản phẩm / dịch vụ") <button type="button" class="btn btn-sm btn-outline-primary" id="addLine">@T("+ Thêm dòng")</button></div>
        <div class="card-body p-0 table-responsive">
            <table class="table mb-0 quote-lines">
                <thead><tr><th style="width:40px">#</th><th style="width:230px">@T("Sản phẩm")</th><th>@T("Diễn giải")</th><th style="width:100px">@T("ĐVT")</th><th style="width:90px">SL</th><th style="width:140px">@T("Đơn giá")</th><th style="width:80px">CK %</th><th class="money" style="width:140px">@T("Thành tiền")</th><th style="width:40px"></th></tr></thead>
                <tbody id="lines">
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var l = Model.Lines[i];
                    <tr class="line">
                        <td class="idx">@(i + 1)</td>
                        <td><select data-f="ProductId" class="form-select form-select-sm product" data-value="@l.ProductId"></select></td>
                        <td><input data-f="Description" class="form-control form-control-sm" value="@l.Description" /></td>
                        <td><input data-f="Unit" list="units" class="form-control form-control-sm" value="@l.Unit" /></td>
                        <td><input data-f="Quantity" type="number" step="0.01" min="0" class="form-control form-control-sm calc" value="@l.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td><input data-f="UnitPrice" type="number" step="1000" min="0" class="form-control form-control-sm calc" value="@l.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td><input data-f="DiscountPercent" type="number" step="0.5" min="0" max="100" class="form-control form-control-sm calc" value="@l.DiscountPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td class="money total">0</td>
                        <td><button type="button" class="btn btn-sm btn-link text-danger remove">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white">
            <div class="row justify-content-end"><div class="col-md-5">
                <table class="table table-sm mb-0">
                    <tr><td>@T("Cộng tiền hàng")</td><td class="money" id="sub">0</td></tr>
                    <tr><td>@T("Chiết khấu chung")</td><td class="money" id="disc">0</td></tr>
                    <tr><td>@T("Thuế GTGT")</td><td class="money" id="vat">0</td></tr>
                    <tr class="fw-bold fs-5"><td>@T("Tổng thanh toán")</td><td class="money" id="grand">0</td></tr>
                </table>
            </div></div>
        </div>
    </div>
    <div class="card mb-3"><div class="card-body"><label asp-for="Terms" class="form-label"></label><textarea asp-for="Terms" class="form-control" rows="3"></textarea></div></div>
    <button class="btn btn-primary">@T("Lưu báo giá")</button> <a asp-action="Index" class="btn btn-light">@T("Hủy")</a>
</form>

<partial name="_CatalogDatalist" model='("units", CatalogGroup.Unit)' />

@section Scripts {
<script>
(function () {
    const products = @Html.Raw(ViewBag.ProductsJson);
    // Bảng giá của khách hàng: giá sản phẩm lấy theo bảng giá (nếu có), không thì giá bán chuẩn
    let custPrices = {};
    const custSel = document.getElementById('CustomerId');
    async function loadPrices() {
        custPrices = {}; let name = null;
        if (custSel && custSel.value) {
            const r = await fetch('@Url.Action("ForCustomer", "PriceLists")?customerId=' + custSel.value);
            if (r.ok) { const d = await r.json(); custPrices = d.prices || {}; name = d.name; }
        }
        document.getElementById('priceListNote').textContent = name ? (@Json.Serialize(T("Áp dụng bảng giá: {0}"))).replace('{0}', name) : '';
    }
    if (custSel) { custSel.addEventListener('change', loadPrices); loadPrices(); }
    const tbody = document.getElementById('lines');
    const fmt = n => Math.round(n).toLocaleString('vi-VN');
    const num = el => parseFloat(el && el.value ? el.value : '0') || 0;

    function fillProducts(sel) {
        const cur = sel.getAttribute('data-value') || sel.value;
        sel.innerHTML = '<option value="">@T("-- Tự nhập --")</option>' +
            products.map(p => `<option value="${p.id}">${p.code} – ${p.name}</option>`).join('');
        if (cur) sel.value = cur;
    }
    function recalc() {
        let sub = 0;
        tbody.querySelectorAll('tr.line').forEach((tr, i) => {
            tr.querySelector('.idx').textContent = i + 1;
            const q = num(tr.querySelector('[data-f=Quantity]')), p = num(tr.querySelector('[data-f=UnitPrice]')), d = num(tr.querySelector('[data-f=DiscountPercent]'));
            const t = Math.round(q * p * (1 - d / 100));
            tr.querySelector('.total').textContent = fmt(t);
            sub += t;
        });
        const disc = Math.round(sub * num(document.getElementById('DiscountPercent')) / 100);
        const vat = Math.round((sub - disc) * num(document.getElementById('VatPercent')) / 100);
        document.getElementById('sub').textContent = fmt(sub);
        document.getElementById('disc').textContent = fmt(disc);
        document.getElementById('vat').textContent = fmt(vat);
        document.getElementById('grand').textContent = fmt(sub - disc + vat);
    }
    function addLine() {
        const tpl = tbody.querySelector('tr.line');
        const tr = tpl ? tpl.cloneNode(true) : null;
        if (!tr) return;
        tr.querySelectorAll('input').forEach(i => i.value = i.getAttribute('data-f') === 'Quantity' ? '1' : (i.getAttribute('data-f') === 'DiscountPercent' || i.getAttribute('data-f') === 'UnitPrice' ? '0' : ''));
        const sel = tr.querySelector('select.product'); sel.removeAttribute('data-value'); fillProducts(sel); sel.value = '';
        tbody.appendChild(tr);
        recalc();
    }
    tbody.querySelectorAll('select.product').forEach(fillProducts);
    document.getElementById('addLine').addEventListener('click', addLine);
    tbody.addEventListener('click', e => {
        if (!e.target.classList.contains('remove')) return;
        if (tbody.querySelectorAll('tr.line').length > 1) e.target.closest('tr').remove();
        else e.target.closest('tr').querySelectorAll('input').forEach(i => i.value = '');
        recalc();
    });
    tbody.addEventListener('change', e => {
        if (!e.target.classList.contains('product')) return;
        const p = products.find(x => String(x.id) === e.target.value);
        if (!p) return;
        const tr = e.target.closest('tr');
        tr.querySelector('[data-f=Description]').value = p.name;
        tr.querySelector('[data-f=Unit]').value = p.unit;
        tr.querySelector('[data-f=UnitPrice]').value = custPrices[p.id] ?? p.price;
        recalc();
    });
    document.addEventListener('input', e => { if (e.target.classList.contains('calc')) recalc(); });
    document.addEventListener('change', e => { if (e.target.classList.contains('calc')) recalc(); });
    // Đặt tên Lines[i].Field liên tục trước khi gửi để model binding đọc đúng
    document.getElementById('quoteForm').addEventListener('submit', () => {
        tbody.querySelectorAll('tr.line').forEach((tr, i) =>
            tr.querySelectorAll('[data-f]').forEach(el => el.name = `Lines[${i}].${el.getAttribute('data-f')}`));
    });
    recalc();
})();
</script>
}
