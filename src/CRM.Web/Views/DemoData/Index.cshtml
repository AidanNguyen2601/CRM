@{
    ViewData["Title"] = T("Dữ liệu mẫu");
    var counts = ((string Label, string Icon, int Count)[])ViewBag.Counts;
}
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-header">@Icon("plus") @T("Nạp thêm dữ liệu mẫu")</div><div class="card-body">
            <p class="small text-muted">@T("Sinh dữ liệu nhất quán theo cả chuỗi nghiệp vụ trong 12 tháng gần nhất: khách hàng, liên hệ, lead, cơ hội, hoạt động, báo giá, PAKD, hợp đồng, hoá đơn, thanh toán. Dữ liệu được NẠP THÊM, không xóa dữ liệu hiện có; người phụ trách chia đều cho nhân viên kinh doanh và quản lý.")</p>
            <form asp-action="Generate" method="post" data-confirm="@T("Nạp thêm dữ liệu mẫu vào hệ thống? Thao tác này không hoàn tác tự động.")">
                <label class="form-label">@T("Số khách hàng mới")</label>
                <div class="d-flex gap-2">
                    <select name="customers" class="form-select" style="max-width:160px">
                        @foreach (var s in CRM.Web.Controllers.DemoDataController.Sizes) { <option value="@s" selected="@(s == 50)">@s</option> }
                    </select>
                    <button class="btn btn-primary">@T("Nạp dữ liệu")</button>
                </div>
                <div class="form-text">@T("Ước tính với 100 khách hàng: ~200 liên hệ, ~120 lead, ~200 cơ hội, ~700 hoạt động, ~100 hợp đồng.")</div>
            </form>
            <hr />
            <h6>@Icon("campaign") @T("Chỉ nạp dữ liệu tiếp thị")</h6>
            <p class="small text-muted">@T("Tạo chiến dịch tiếp thị trong 12 tháng gần nhất trên khách hàng / lead đang có: danh sách đối tượng với trạng thái tiếp cận, chi phí, và gắn các lead / cơ hội phát sinh trong thời gian chạy vào chiến dịch. Không tạo khách hàng mới.")</p>
            <form asp-action="GenerateMarketing" method="post" data-confirm="@T("Nạp chiến dịch tiếp thị mẫu? Thao tác này không hoàn tác tự động.")">
                <label class="form-label">@T("Số chiến dịch")</label>
                <div class="d-flex gap-2">
                    <select name="campaigns" class="form-select" style="max-width:160px">
                        @foreach (var s in CRM.Web.Controllers.DemoDataController.MarketingSizes) { <option value="@s" selected="@(s == 8)">@s</option> }
                    </select>
                    <button class="btn btn-outline-primary">@T("Nạp dữ liệu tiếp thị")</button>
                </div>
            </form>
            @if ((int)ViewBag.BranchCount <= 1)
            {
                <hr />
                <h6>@Icon("branch") @T("Tạo cơ cấu chuỗi mẫu")</h6>
                <p class="small text-muted">@T("Hệ thống đang có 1 đơn vị. Tạo 2 chi nhánh mẫu (TP.HCM, Hà Nội) trực thuộc đơn vị gốc, chia nhân viên kinh doanh xen kẽ vào 2 chi nhánh và chuyển dữ liệu họ phụ trách theo – để thử xem dữ liệu theo từng chi nhánh.")</p>
                <form asp-action="GenerateChain" method="post" data-confirm="@T("Tạo cơ cấu chuỗi mẫu và chia nhân viên kinh doanh vào 2 chi nhánh?")">
                    <button class="btn btn-outline-primary">@Icon("branch") @T("Tạo cơ cấu chuỗi mẫu")</button>
                </form>
            }
            <hr />
            <h6>@Icon("support") @T("Chỉ nạp phiếu hỗ trợ (CSKH)")</h6>
            <p class="small text-muted">@T("Tạo phiếu hỗ trợ trên khách hàng đang có (ưu tiên khách đã ký hợp đồng, gắn hợp đồng và hàng hoá): đủ các trạng thái từ mới đến đã đóng, trao đổi và ghi chú nội bộ, thời gian xử lý dao động quanh hạn SLA (một phần trễ hạn), điểm hài lòng của khách. Người xử lý là nhân viên CSKH (chưa có thì giao cho quản lý). Không tạo khách hàng mới.")</p>
            <form asp-action="GenerateSupport" method="post" data-confirm="@T("Nạp phiếu hỗ trợ mẫu? Thao tác này không hoàn tác tự động.")">
                <label class="form-label">@T("Số phiếu hỗ trợ")</label>
                <div class="d-flex gap-2">
                    <select name="tickets" class="form-select" style="max-width:160px">
                        @foreach (var s in CRM.Web.Controllers.DemoDataController.SupportSizes) { <option value="@s" selected="@(s == 50)">@s</option> }
                    </select>
                    <button class="btn btn-outline-primary">@T("Nạp phiếu hỗ trợ")</button>
                </div>
                @if (!(bool)ViewBag.HasSupportAgent)
                {
                    <div class="form-text text-warning-emphasis">@T("Chưa có người dùng vai trò Nhân viên CSKH – phiếu sẽ được giao cho quản lý / quản trị.")</div>
                }
            </form>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-header">@T("Số bản ghi hiện có")</div>
            <div class="card-body p-0"><table class="table mb-0" data-no-grid>
                <tbody>
                @foreach (var c in counts)
                {
                    <tr><td>@Icon(c.Icon) @c.Label</td><td class="money fw-semibold">@c.Count.ToString("N0")</td></tr>
                }
                </tbody>
            </table></div>
        </div>
    </div>
</div>
