@model Enum
@{
    var css = Model switch
    {
        LeadStatus.New or QuoteStatus.Draft or ActivityStatus.Planned or BusinessPlanStatus.Draft or ContractStatus.Draft or InvoiceStatus.Draft => "bg-secondary",
        LeadStatus.Contacted or OpportunityStage.Qualification or QuoteStatus.Sent => "bg-info text-dark",
        LeadStatus.Qualified or OpportunityStage.Proposal => "bg-primary",
        OpportunityStage.Negotiation or Priority.Normal or BusinessPlanStatus.Pending or InvoiceStatus.PartiallyPaid => "bg-warning text-dark",
        LeadStatus.Converted or OpportunityStage.ClosedWon or QuoteStatus.Accepted or BusinessPlanStatus.Approved or ContractStatus.Completed or InvoiceStatus.Paid or ActivityStatus.Completed or CustomerType.Customer => "bg-success",
        LeadStatus.Unqualified or OpportunityStage.ClosedLost or QuoteStatus.Rejected or BusinessPlanStatus.Rejected or ContractStatus.Cancelled or InvoiceStatus.Cancelled or ActivityStatus.Cancelled or CustomerType.Inactive or Priority.High => "bg-danger",
        LeadRating.Hot => "bg-danger", LeadRating.Warm => "bg-warning text-dark", LeadRating.Cold => "bg-info text-dark",
        CustomerType.Partner => "bg-primary",
        ContractStatus.Active or InvoiceStatus.Issued => "bg-primary",
        ContractStatus.Liquidated => "bg-dark",
        CampaignStatus.Planned or CampaignMemberStatus.Pending => "bg-secondary",
        CampaignStatus.Active or CampaignMemberStatus.Sent => "bg-primary",
        CampaignStatus.Completed or CampaignMemberStatus.Converted => "bg-success",
        CampaignStatus.Cancelled or CampaignMemberStatus.Unsubscribed => "bg-danger",
        CampaignMemberStatus.Responded => "bg-info text-dark",
        CampaignMemberStatus.Declined => "bg-warning text-dark",
        CampaignMemberStatus.Failed => "bg-light text-dark border",
        SalesPlanStatus.Draft => "bg-secondary",
        SalesPlanStatus.Pending => "bg-warning text-dark",
        SalesPlanStatus.Approved => "bg-success",
        SalesPlanStatus.Rejected => "bg-danger",
        SalesPlanStatus.Closed => "bg-dark",
        TicketStatus.New => "bg-info text-dark",
        TicketStatus.InProgress => "bg-primary",
        TicketStatus.WaitingCustomer => "bg-warning text-dark",
        TicketStatus.Resolved => "bg-success",
        TicketStatus.Closed => "bg-dark",
        TicketPriority.Low => "bg-light text-dark border",
        TicketPriority.Normal => "bg-secondary",
        TicketPriority.High => "bg-warning text-dark",
        TicketPriority.Urgent => "bg-danger",
        _ => "bg-light text-dark border"
    };
}
<span class="badge @css">@Model.GetDisplayName()</span>
