@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => ctrl == c && (a == null || act == a) ? "active" : "";
    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var ui = await UiService.CurrentAsync(User);   // cấu hình giao diện (Hệ thống → Giao diện)
}
<!DOCTYPE html>
<html lang="@Lang" data-theme="@(ui.Theme == "dark" ? "dark" : "light")" data-theme-pref="@ui.Theme" data-menu="@ui.Menu" data-sidebar="@ui.Sidebar" style="@ui.CssVars()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script>
        // Áp dụng trước khi vẽ trang để không bị nháy: menu rút gọn + chủ đề "theo hệ thống"
        (function () {
            var r = document.documentElement;
            try { if (localStorage.getItem('crm.nav.mini') === '1') r.classList.add('sidebar-mini'); } catch (e) { }
            if (r.dataset.themePref === 'auto' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) r.dataset.theme = 'dark';
        })();
    </script>
</head>
<body data-page="@ctrl.@act">
<div class="app">
    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-full">CRM<span>Sales</span></span><span class="brand-mini">C<span>S</span></span></a>
        @*
            Menu có thể: (1) rút gọn chỉ còn icon, (2) mở rộng / thu gọn từng nhóm.
            Mỗi .nav-block có data-nav là khóa lưu trạng thái (localStorage) – xem wwwroot/js/site.js.
        *@
        <nav id="sideNav">
            @* ===== NGHIỆP VỤ: các chức năng làm việc hằng ngày ===== *@
            <div class="nav-block" data-nav="ops">
                <button type="button" class="nav-section nav-toggle" aria-expanded="true"><span>@T("Nghiệp vụ")</span>@Icon("chevron", "chev")</button>
                <div class="nav-items"><div class="nav-inner">
                    <div class="nav-block hnav-item" data-nav="ops-overview">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@T("Tổng quan")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            <a class="@Active("Home")" asp-controller="Home" asp-action="Index">@Icon("dashboard")<span>Dashboard</span></a>
                            @if (Perms.CanController(User, "Activities")) { <a class="@Active("Activities")" asp-controller="Activities" asp-action="Index">@Icon("calendar")<span>@T("Lịch làm việc")</span></a> }
                            @if (Perms.CanController(User, "Tasks")) { <a class="@Active("Tasks")" asp-controller="Tasks" asp-action="Index">@Icon("kanban")<span>@T("Công việc")</span></a> }
                            @if (Perms.CanController(User, "Kpi")) { <a class="@Active("Kpi")" asp-controller="Kpi" asp-action="Index">@Icon("trending")<span>@T("KPI bán hàng")</span></a> }
                            @if (Perms.CanController(User, "Forecast")) { <a class="@Active("Forecast")" asp-controller="Forecast" asp-action="Index">@Icon("target")<span>@T("Dự báo doanh số")</span></a> }
                            @if (Perms.CanController(User, "Commissions")) { <a class="@Active("Commissions")" asp-controller="Commissions" asp-action="Index">@Icon("coins")<span>@T("Hoa hồng")</span></a> }
                            @if (Perms.CanController(User, "SalesPlans")) { <a class="@Active("SalesPlans")" asp-controller="SalesPlans" asp-action="Index">@Icon("target")<span>@T("Kế hoạch bán hàng")</span></a> }
                            @if (Perms.CanController(User, "Reports")) { <a class="@Active("Reports")" asp-controller="Reports" asp-action="Index">@Icon("report")<span>@T("Báo cáo")</span></a> }
                        </div></div>
                    </div>
                    <div class="nav-block hnav-item" data-nav="ops-sales">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@T("Bán hàng")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            @if (Perms.CanController(User, "Leads")) { <a class="@Active("Leads")" asp-controller="Leads" asp-action="Index">@Icon("lead")<span>@T("Lead (KH tiềm năng)")</span></a> }
                            @if (Perms.CanController(User, "Opportunities")) { <a class="@Active("Opportunities","Pipeline")" asp-controller="Opportunities" asp-action="Pipeline">@Icon("pipeline")<span>Pipeline</span></a> }
                            @if (Perms.CanController(User, "Opportunities")) { <a class="@(ctrl == "Opportunities" && act != "Pipeline" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">@Icon("opportunity")<span>@T("Cơ hội bán hàng")</span></a> }
                            @if (Perms.CanController(User, "Quotes")) { <a class="@Active("Quotes")" asp-controller="Quotes" asp-action="Index">@Icon("quote")<span>@L("Báo giá", "Quotes")</span></a> }
                            @if (User.SeesAll() && Perms.CanController(User, "PriceLists")) { <a class="@Active("PriceLists")" asp-controller="PriceLists" asp-action="Index">@Icon("receivable")<span>@T("Bảng giá & chiết khấu")</span></a> }
                            @if (Perms.CanController(User, "BusinessPlans")) { <a class="@Active("BusinessPlans")" asp-controller="BusinessPlans" asp-action="Index">@Icon("plan")<span>@T("Phương án kinh doanh")</span></a> }
                        </div></div>
                    </div>
                    <div class="nav-block hnav-item" data-nav="ops-marketing">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@T("Tiếp thị")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            @if (Perms.CanController(User, "Campaigns")) { <a class="@Active("Campaigns")" asp-controller="Campaigns" asp-action="Index">@Icon("campaign")<span>@T("Chiến dịch tiếp thị")</span></a> }
                            @if (User.SeesAll() && Perms.CanController(User, "WebForms")) { <a class="@Active("WebForms")" asp-controller="WebForms" asp-action="Index">@Icon("globe")<span>@T("Form thu lead website")</span></a> }
                        </div></div>
                    </div>
                    <div class="nav-block hnav-item" data-nav="ops-finance">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@T("Hợp đồng & công nợ")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            @if (Perms.CanController(User, "Contracts")) { <a class="@Active("Contracts")" asp-controller="Contracts" asp-action="Index">@Icon("contract")<span>@L("Hợp đồng", "Contracts")</span></a> }
                            @if (Perms.CanController(User, "Renewals")) { <a class="@Active("Renewals")" asp-controller="Renewals" asp-action="Index">@Icon("undo")<span>@T("Gia hạn & định kỳ")</span></a> }
                            @if (Perms.CanController(User, "Invoices")) { <a class="@Active("Invoices")" asp-controller="Invoices" asp-action="Index">@Icon("invoice")<span>@L("Hoá đơn", "Invoices")</span></a> }
                            @if (Perms.CanController(User, "Payments")) { <a class="@Active("Payments")" asp-controller="Payments" asp-action="Index">@Icon("wallet")<span>@T("Thanh toán")</span></a> }
                        </div></div>
                    </div>
                    <div class="nav-block hnav-item" data-nav="ops-support">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@T("Chăm sóc khách hàng")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            @if (Perms.CanController(User, "Tickets")) { <a class="@(ctrl == "Tickets" && act != "Workload" ? "active" : "")" asp-controller="Tickets" asp-action="Index">@Icon("support")<span>@T("Phiếu hỗ trợ")</span></a> }
                            @if (User.IsSupportDesk())
                            {
                                @if (Perms.CanController(User, "Tickets")) { <a class="@Active("Tickets", "Workload")" asp-controller="Tickets" asp-action="Workload">@Icon("users")<span>@T("Phân công việc")</span></a> }
                                <a class="@Active("Nps")" asp-controller="Nps" asp-action="Index">@Icon("star")<span>@T("Khảo sát NPS")</span></a>
                                @if (User.SeesAll()) { <a class="@Active("Sla")" asp-controller="Sla" asp-action="Index">@Icon("clock")<span>@T("SLA & giờ làm việc")</span></a> }
                            }
                            <a class="@Active("Kb")" asp-controller="Kb" asp-action="Index">@Icon("catalog")<span>@T("Kho kiến thức")</span></a>
                        </div></div>
                    </div>
                    <div class="nav-block hnav-item" data-nav="ops-customers">
                        <button type="button" class="nav-group nav-toggle" aria-expanded="true"><span>@L("Khách hàng", "Customers")</span>@Icon("chevron", "chev")</button>
                        <div class="nav-items"><div class="nav-inner">
                            @if (Perms.CanController(User, "Customers")) { <a class="@Active("Customers")" asp-controller="Customers" asp-action="Index">@Icon("customer")<span>@L("Khách hàng", "Customers")</span></a> }
                            @if (Perms.CanController(User, "Health")) { <a class="@Active("Health")" asp-controller="Health" asp-action="Index">@Icon("star")<span>@T("Sức khoẻ khách hàng")</span></a> }
                            @if (Perms.CanController(User, "Contacts")) { <a class="@Active("Contacts")" asp-controller="Contacts" asp-action="Index">@Icon("contact")<span>@L("Người liên hệ", "Contacts")</span></a> }
                        </div></div>
                    </div>
                </div></div>
            </div>

            @* ===== DANH MỤC: dữ liệu dùng chung ===== *@
            <div class="nav-block hnav-item" data-nav="catalog">
                <button type="button" class="nav-section nav-toggle" aria-expanded="true"><span>@T("Danh mục")</span>@Icon("chevron", "chev")</button>
                <div class="nav-items"><div class="nav-inner">
                    @if (Perms.CanController(User, "Products")) { <a class="@Active("Products")" asp-controller="Products" asp-action="Index">@Icon("product")<span>@T("Hàng hoá / dịch vụ")</span></a> }
                    @if (User.SeesAll())
                    {
                        var curGroup = ctrl == "Catalogs" ? ViewData["CatalogGroup"] as CatalogGroup? : null;
                        foreach (var cg in Enum.GetValues<CatalogGroup>())
                        {
                            <a class="@(curGroup == cg ? "active" : "")" asp-controller="Catalogs" asp-action="Index" asp-route-group="@cg">@Icon(ForCatalog(cg))<span>@cg.GetDisplayName()</span></a>
                        }
                    }
                </div></div>
            </div>

            @* ===== TIỆN ÍCH + HỆ THỐNG ===== *@
            <div class="nav-block hnav-item" data-nav="system">
                <button type="button" class="nav-section nav-toggle" aria-expanded="true"><span>@T("Hệ thống")</span>@Icon("chevron", "chev")</button>
                <div class="nav-items"><div class="nav-inner">
                    @if (Perms.CanController(User, "Emails")) { <a class="@Active("Emails")" asp-controller="Emails" asp-action="Index">@Icon("email")<span>@T("Email đã gửi")</span></a> }
                    @if (Perms.CanController(User, "Import")) { <a class="@Active("Import")" asp-controller="Import" asp-action="Index">@Icon("upload")<span>@T("Nhập dữ liệu Excel")</span></a> }
                    @if (User.SeesAll())
                    {
                        @if (Perms.CanController(User, "Duplicates")) { <a class="@Active("Duplicates")" asp-controller="Duplicates" asp-action="Index">@Icon("customer")<span>@T("Kiểm tra trùng")</span></a> }
                        <a class="@Active("Automation")" asp-controller="Automation" asp-action="Index">@Icon("kanban")<span>@T("Tự động hoá")</span></a>
                        <a class="@Active("Tags")" asp-controller="Tags" asp-action="Index">@Icon("category")<span>@T("Nhãn & trường tùy biến")</span></a>
                        <a class="@Active("Audit")" asp-controller="Audit" asp-action="Index">@Icon("clock")<span>@T("Nhật ký hệ thống")</span></a>
                    }
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <a class="@Active("Branches")" asp-controller="Branches" asp-action="Index">@Icon("branch")<span>@T("Công ty & chi nhánh")</span></a>
                        <a class="@Active("Users")" asp-controller="Users" asp-action="Index">@Icon("users")<span>@T("Người dùng")</span></a>
                        <a class="@Active("Security")" asp-controller="Security" asp-action="Index">@Icon("key")<span>@T("Bảo mật & phân quyền")</span></a>
                        <a class="@Active("Inbound")" asp-controller="Inbound" asp-action="Index">@Icon("email")<span>@T("Email → phiếu hỗ trợ")</span></a>
                        <a class="@Active("Pdf")" asp-controller="Pdf" asp-action="Index">@Icon("file-pdf")<span>@T("Mẫu in PDF")</span></a>
                        <a class="@Active("DemoData")" asp-controller="DemoData" asp-action="Index">@Icon("receivable")<span>@T("Dữ liệu mẫu")</span></a>
                    }
                </div></div>
            </div>
        </nav>
        <script>
            // Áp dụng trạng thái nhóm đã lưu ngay khi dựng menu (tránh nháy giao diện)
            (function () {
                var nav = document.getElementById('sideNav'), collapsed = [];
                try { collapsed = JSON.parse(localStorage.getItem('crm.nav.collapsed') || '[]'); } catch (e) { }
                collapsed.forEach(function (k) {
                    var b = nav.querySelector('.nav-block[data-nav="' + k + '"]');
                    if (b && !b.querySelector('a.active')) { b.classList.add('collapsed'); b.querySelector('.nav-toggle').setAttribute('aria-expanded', 'false'); }
                });
            })();
        </script>
        <div class="sidebar-foot">
            <button type="button" class="side-btn" data-nav-all="expand" title="@T("Mở rộng tất cả")">@Icon("expand-all")<span>@T("Mở rộng tất cả")</span></button>
            <button type="button" class="side-btn" data-nav-all="collapse" title="@T("Thu gọn tất cả")">@Icon("collapse-all")<span>@T("Thu gọn tất cả")</span></button>
            <button type="button" class="side-btn side-mini-btn" data-sidebar-toggle data-label-collapse="@T("Rút gọn menu")" data-label-expand="@T("Mở rộng menu")" title="@T("Rút gọn menu")">@Icon("panel")<span>@T("Rút gọn menu")</span></button>
        </div>
    </aside>
    <div class="sidebar-backdrop" data-sidebar-close></div>

    <div class="main">
        <header class="topbar">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <button type="button" class="btn btn-light btn-sm menu-btn" data-sidebar-toggle title="@T("Ẩn / hiện menu")" aria-label="@T("Ẩn / hiện menu")" aria-controls="sidebar">@Icon("menu")</button>
                <h1 class="page-title">@Icon(ForPage(ctrl, act) ?? "", "ico-title")<span>@ViewData["Title"]</span></h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <partial name="_NotificationBell" />
                <partial name="_BranchSwitcher" />
                <partial name="_LanguageSwitcher" />
                <div class="dropdown">
                    <button class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">@Icon("plus") @T("Tạo nhanh")</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Leads" asp-action="Create">@Icon("lead")Lead</a></li>
                        <li><a class="dropdown-item" asp-controller="Customers" asp-action="Create">@Icon("customer")@T("Khách hàng")</a></li>
                        <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Create">@Icon("opportunity")@T("Cơ hội")</a></li>
                        <li><a class="dropdown-item" asp-controller="Activities" asp-action="Create">@Icon("calendar")@T("Hoạt động")</a></li>
                        <li><a class="dropdown-item" asp-controller="Tasks" asp-action="Create">@Icon("kanban")@T("Giao việc")</a></li>
                        <li><a class="dropdown-item" asp-controller="Quotes" asp-action="Create">@Icon("quote")@L("Báo giá", "Quote")</a></li>
                        <li><a class="dropdown-item" asp-controller="BusinessPlans" asp-action="Create">@Icon("plan")@T("Phương án kinh doanh")</a></li>
                        <li><a class="dropdown-item" asp-controller="Campaigns" asp-action="Create">@Icon("campaign")@T("Chiến dịch tiếp thị")</a></li>
                        @if (User.SeesAll()) { <li><a class="dropdown-item" asp-controller="SalesPlans" asp-action="Create">@Icon("target")@T("Kế hoạch bán hàng")</a></li> }
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Contracts" asp-action="Create">@Icon("contract")@T("Hợp đồng")</a></li>
                        <li><a class="dropdown-item" asp-controller="Invoices" asp-action="Create">@Icon("invoice")@T("Hoá đơn")</a></li>
                        <li><a class="dropdown-item" asp-controller="Payments" asp-action="Create">@Icon("wallet")@T("Phiếu thu")</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Tickets" asp-action="Create">@Icon("support")@T("Phiếu hỗ trợ")</a></li>
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="avatar">@(User.GetFullName().Length > 0 ? char.ToUpper(User.GetFullName().Split(' ').Last()[0]) : '?')</span>
                        @User.GetFullName() <small class="text-muted">(@AppRoles.DisplayName(role))</small>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">@Icon("contact")@T("Tài khoản của tôi")</a></li>
                        <li><a class="dropdown-item" asp-controller="Appearance" asp-action="Index">@Icon("palette")@T("Giao diện")</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">@Icon("key")@T("Đổi mật khẩu")</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">@Icon("logout")@T("Đăng xuất")</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="content">
            @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </main>
        <footer class="footer">&copy; @DateTime.Now.Year CRM System — ASP.NET Core 8 MVC + SQL Server</footer>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
