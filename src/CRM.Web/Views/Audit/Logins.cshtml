@model PagedList<LoginLog>
@using CRM.Web.Controllers
@{
    ViewData["Title"] = T("Nhật ký hệ thống");
    var f = (AuditFilter)ViewBag.Filter;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link" asp-action="Index">@Icon("clock") @T("Thay đổi dữ liệu")</a></li>
    <li class="nav-item"><a class="nav-link active" asp-action="Logins">@Icon("key") @T("Lịch sử đăng nhập")</a></li>
</ul>
@if ((int)ViewBag.Failed24h > 0)
{
    <div class="alert alert-warning py-2">@Icon("alert") @T("{0} lần đăng nhập thất bại trong 24 giờ qua.", ViewBag.Failed24h)</div>
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Người dùng")</label>
        <select name="UserId" class="form-select" asp-items="ViewBag.Users"><option value="">@T("-- Tất cả --")</option></select></div>
    <div><label class="form-label small mb-1">@T("Từ ngày")</label><input type="date" name="From" value="@D(f.From)" class="form-control" /></div>
    <div><label class="form-label small mb-1">@T("Đến ngày")</label><input type="date" name="To" value="@D(f.To)" class="form-control" /></div>
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Tên đăng nhập, IP")" /></div>
    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="FailedOnly" value="true" id="failed" @(f.FailedOnly ? "checked" : "") /><label class="form-check-label" for="failed">@T("Chỉ lần thất bại")</label></div>
    <button class="btn btn-outline-primary">@T("Lọc")</button>
</form>
<div class="card"><div class="card-body p-0 table-responsive">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Thời gian")</th><th>@T("Tên đăng nhập")</th><th>@T("Kết quả")</th><th>@T("IP")</th><th>@T("Trình duyệt")</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Items)
    {
        <tr>
            <td class="text-nowrap">@a.At.ToDateTime()</td>
            <td>@a.Username</td>
            <td>@if (a.Success) { <span class="badge bg-success">@T("Thành công")</span> } else { <span class="badge bg-danger">@T("Thất bại")</span> }
                @if (!string.IsNullOrEmpty(a.Reason)) { <span class="small text-muted">@T(a.Reason)</span> }</td>
            <td class="small">@a.Ip</td>
            <td class="small text-muted text-truncate" style="max-width:360px" title="@a.UserAgent">@a.UserAgent</td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="5" class="text-center text-muted p-4">@T("Không có dữ liệu.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="small text-muted">@T("{0} lượt đăng nhập", Model.TotalCount)</span>
    <partial name="_Pager" model="Model" />
</div></div>
