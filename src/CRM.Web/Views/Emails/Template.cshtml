@model EmailTemplate
@{
    ViewData["Title"] = Model.Id == 0 ? T("Thêm mẫu email") : T("Sửa mẫu email");
    var scopes = new[] { nameof(Customer), nameof(Contact), nameof(Opportunity), nameof(Quote), nameof(Contract), nameof(Invoice), nameof(Ticket), nameof(Campaign) };
}
<form asp-action="Template" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-lg-8"><div class="card"><div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-7"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                <div class="col-md-5"><label asp-for="Scope" class="form-label"></label>
                    @if (Model.Code != null) { <input class="form-control" value="@T("Hệ thống")" readonly /> }
                    else
                    {
                        <select asp-for="Scope" class="form-select"><option value="">@T("Mọi nơi")</option>
                            @foreach (var s in scopes) { <option value="@s">@AuditTrail.TypeLabel(s)</option> }</select>
                    }</div>
                <div class="col-12"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" rows="14" class="form-control font-monospace small"></textarea><span asp-validation-for="Body" class="text-danger small"></span></div>
                <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
            </div>
            <div class="d-flex gap-2 mt-3"><button class="btn btn-primary">@T("Lưu")</button><a class="btn btn-light" asp-action="Templates">@T("Hủy")</a></div>
        </div></div></div>
        <div class="col-lg-4"><div class="card"><div class="card-header">@T("Biến trộn")</div>
            <ul class="list-group list-group-flush small">
                @foreach (var (n, d) in EmailComposer.Variables)
                {
                    <li class="list-group-item d-flex justify-content-between gap-2"><code class="var-pick" role="button" title="@T("Bấm để chèn")">{{@n}}</code><span class="text-muted text-end">@T(d)</span></li>
                }
                @if (Model.Code == "password-reset" || Model.Code == "notification")
                {
                    <li class="list-group-item"><code>{{Link}}</code> <span class="text-muted">@T("Liên kết trong email hệ thống")</span></li>
                    <li class="list-group-item"><code>{{NoiDung}}</code> <span class="text-muted">@T("Nội dung thông báo")</span></li>
                }
            </ul>
            <div class="card-footer bg-white small text-muted">@T("Nội dung viết dạng văn bản thường hoặc HTML.")</div>
        </div></div>
    </div>
</form>
@section Scripts {
<script>
    document.querySelectorAll('.var-pick').forEach(c => c.addEventListener('click', () => {
        const ta = document.getElementById('Body'), s = ta.selectionStart, v = c.textContent;
        ta.value = ta.value.slice(0, s) + v + ta.value.slice(ta.selectionEnd);
        ta.focus(); ta.selectionStart = ta.selectionEnd = s + v.length;
    }));
</script>
}
