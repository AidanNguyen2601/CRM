@model EmailMessage
@{
    ViewData["Title"] = T("Email: {0}", Model.Subject);
    var s = (SmtpSettings)ViewBag.Settings;
}
<div class="toolbar">
    <a class="btn btn-light" asp-action="Index">← @T("Email đã gửi")</a>
    @if (Model.Status == EmailStatus.Failed)
    {
        <form asp-action="Retry" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">@Icon("send") @T("Gửi lại")</button></form>
    }
</div>
<div class="card" style="max-width:900px"><div class="card-body">
    <dl class="row small mb-2">
        <dt class="col-sm-2 text-muted">@T("Đến")</dt><dd class="col-sm-10 text-break">@Model.To</dd>
        @if (!string.IsNullOrEmpty(Model.Cc)) { <dt class="col-sm-2 text-muted">CC</dt><dd class="col-sm-10 text-break">@Model.Cc</dd> }
        <dt class="col-sm-2 text-muted">@T("Tiêu đề")</dt><dd class="col-sm-10 fw-semibold">@Model.Subject</dd>
        <dt class="col-sm-2 text-muted">@T("Trạng thái")</dt>
        <dd class="col-sm-10"><span class="badge @(Model.Status == EmailStatus.Sent ? "bg-success" : Model.Status == EmailStatus.Failed ? "bg-danger" : "bg-warning text-dark")">@Model.Status.GetDisplayName()</span>
            @if (Model.SentAt.HasValue) { <span class="text-muted">@Model.SentAt.Value.ToDateTime()</span> }
            @T("· {0} lần thử", Model.Attempts)</dd>
        @if (!string.IsNullOrEmpty(Model.Error)) { <dt class="col-sm-2 text-muted">@T("Lỗi")</dt><dd class="col-sm-10 text-danger text-break">@Model.Error</dd> }
        <dt class="col-sm-2 text-muted">@T("Người gửi")</dt><dd class="col-sm-10">@(Model.CreatedBy?.FullName ?? T("Hệ thống")) · @Model.CreatedAt.ToDateTime()</dd>
    </dl>
    <hr />
    @* Nội dung email hiển thị trong khung cô lập (sandbox) để không ảnh hưởng trang *@
    <iframe sandbox="" class="email-frame" srcdoc="@EmailService.Wrap(Model.Body, s)"></iframe>
</div></div>
