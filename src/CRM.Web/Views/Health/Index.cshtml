@model List<CRM.Web.Controllers.HealthController.Row>
@{
    ViewData["Title"] = T("Sức khoẻ khách hàng");
    var dist = (Dictionary<string, (int N, decimal Rev)>)ViewBag.Dist;
    var total = (int)ViewBag.Total;
    var level = (string)ViewBag.Level;
    var ownerId = (int?)ViewBag.OwnerId;
    var lastRun = (DateTime?)ViewBag.LastRun;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<form method="get" class="toolbar align-items-end">
    <input type="hidden" name="level" value="@level" />
    @if (ViewBag.Owners != null)
    {
        <div><label class="form-label small mb-1">@T("Phụ trách")</label>
            <select name="ownerId" class="form-select" asp-items="ViewBag.Owners" onchange="this.form.submit()"><option value="">@T("-- Tất cả --")</option></select></div>
    }
    <div class="small text-muted mb-2">@(lastRun.HasValue ? T("Cập nhật lúc {0} – tự tính lại mỗi giờ", lastRun.Value.ToDateTime()) : T("Chưa tính điểm – bấm \"Tính lại ngay\""))</div>
    @if (User.SeesAll())
    {
        <button form="recalc" class="btn btn-outline-primary ms-auto">@T("Tính lại ngay")</button>
    }
</form>
@if (User.SeesAll()) { <form id="recalc" asp-action="Recalculate" method="post" class="d-none"></form> }

<div class="row g-3 mb-3">
    @foreach (var (key, icon) in new[] { ("risk", "alert"), ("warn", "clock"), ("good", "check") })
    {
        var d = dist.GetValueOrDefault(key);
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none @(level == key ? "border-" + CustomerHealth.LevelCss(key) + " border-2" : "")" asp-route-level="@key" asp-route-ownerId="@ownerId">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 text-@CustomerHealth.LevelCss(key)">@Icon(icon) <span class="fw-semibold">@CustomerHealth.LevelText(key)</span>
                        <span class="ms-auto small text-muted">@(key == "good" ? "≥ " + CustomerHealth.GoodFrom : key == "warn" ? CustomerHealth.WarnFrom + "–" + (CustomerHealth.GoodFrom - 1) : "< " + CustomerHealth.WarnFrom)</span></div>
                    <div class="fs-3 fw-semibold text-body">@d.N <span class="fs-6 text-muted">/ @total @T("khách hàng")</span></div>
                    <div class="small text-muted">@T("Doanh thu 12 tháng: {0}", d.Rev.ToShortMoney())</div>
                    @if (total > 0) { <div class="kpi-bar mt-2"><div class="bg-@CustomerHealth.LevelCss(key)" style="width:@((100.0 * d.N / total).ToString("0.#", inv))%"></div></div> }
                </div>
            </a>
        </div>
    }
</div>
@if (dist.TryGetValue("none", out var none) && none.N > 0) { <div class="small text-muted mb-2">@T("{0} khách hàng chưa có điểm (mới thêm – sẽ được tính ở lần chạy tới).", none.N)</div> }

<div class="card"><div class="card-header d-flex align-items-center gap-2">
        @Icon("customer") @(level == "all" ? T("Tất cả khách hàng") : CustomerHealth.LevelText(level))
        <span class="text-muted small">@T("– xếp theo doanh thu 12 tháng, tối đa 100 khách")</span>
        <a class="ms-auto small" asp-route-level="all" asp-route-ownerId="@ownerId">@T("Xem tất cả")</a>
    </div>
    <div class="card-body p-0 table-responsive"><table class="table table-hover mb-0 align-middle">
        <thead><tr><th>@T("Khách hàng")</th><th>@T("Điểm")</th><th>@T("Nguyên nhân chính")</th><th style="min-width:260px">@T("Các yếu tố")</th><th class="money">@T("Doanh thu 12 tháng")</th><th>@T("Phụ trách")</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            var lv = r.Result.Level;
            var weak = CustomerHealth.Weakest(r.Result);
            <tr>
                <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@r.Customer.Id" class="fw-semibold">@r.Customer.Name</a><div class="small text-muted">@r.Customer.Code</div></td>
                <td><span class="badge text-bg-@CustomerHealth.LevelCss(lv) fs-6">@r.Result.Score</span>
                    @if (r.Customer.HealthScore is int stored && stored != r.Result.Score) { <div class="small text-muted" title="@T("Điểm lưu ở lần tính trước")">@T("trước: {0}", stored)</div> }</td>
                <td class="small">@if (weak != null) { <b>@weak.Name:</b> @weak.Note }</td>
                <td>
                    <div class="d-flex gap-1">
                        @foreach (var fct in r.Result.Factors)
                        {
                            var pc = fct.Max == 0 ? 0 : 100.0 * fct.Score / fct.Max;
                            <div class="flex-fill" title="@fct.Name: @fct.Score/@fct.Max – @fct.Note">
                                <div class="kpi-bar mt-0"><div class="bg-@(pc >= 70 ? "success" : pc >= 40 ? "warning" : "danger")" style="width:@(Math.Max(4, pc).ToString("0", inv))%"></div></div>
                            </div>
                        }
                    </div>
                    <div class="small text-muted mt-1">@string.Join(" · ", r.Result.Factors.Select(x => $"{x.Name} {x.Score}/{x.Max}"))</div>
                </td>
                <td class="money">@r.Revenue12m.ToShortMoney()</td>
                <td class="small">@r.Customer.Owner?.FullName</td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6" class="text-muted p-3">@T("Không có khách hàng ở mức này.")</td></tr> }
        </tbody>
    </table></div>
</div>
