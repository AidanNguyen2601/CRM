@model Contact
@{
    ViewData["Title"] = T("Tổng quan");
    var open = (List<Ticket>)ViewBag.OpenTickets;
}
<h4 class="mb-3">@T("Xin chào {0}", Model.FullName)</h4>
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card stat h-100"><div class="label">@T("Yêu cầu đang xử lý")</div><div class="value">@open.Count(t => t.Status != TicketStatus.Resolved)</div></div></div>
    <div class="col-md-4"><div class="card stat h-100"><div class="label">@T("Công nợ cần thanh toán")</div><div class="value">@(((decimal)ViewBag.Outstanding).ToMoney()) đ</div></div></div>
    <div class="col-md-4"><div class="card stat h-100"><div class="label">@T("Hợp đồng đang thực hiện")</div><div class="value">@ViewBag.ActiveContracts</div></div></div>
</div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center">@T("Yêu cầu hỗ trợ gần đây")<a class="btn btn-sm btn-primary" asp-action="NewTicket">@T("+ Gửi yêu cầu mới")</a></div>
    <ul class="list-group list-group-flush">
        @foreach (var t in open)
        {
            <li class="list-group-item d-flex justify-content-between gap-2"><span><a asp-action="Ticket" asp-route-id="@t.Id">@t.Number</a> – @t.Subject</span><partial name="_Badge" model="t.Status" /></li>
        }
        @if (!open.Any()) { <li class="list-group-item text-muted small">@T("Không có yêu cầu đang mở.")</li> }
    </ul>
</div>
