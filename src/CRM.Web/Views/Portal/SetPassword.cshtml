@{ ViewData["Title"] = T("Đặt mật khẩu"); }
<div class="card mx-auto" style="max-width:420px"><div class="card-body p-4">
    <h4 class="mb-3">@T("Đặt mật khẩu")</h4>
    @if (!(bool)ViewBag.Valid)
    {
        <p class="text-muted">@T("Liên kết không hợp lệ, đã được dùng hoặc đã hết hạn.")</p>
        <a asp-action="Forgot" class="btn btn-primary w-100">@T("Gửi lại liên kết")</a>
    }
    else
    {
        <form asp-action="SetPassword" method="post" autocomplete="off">
            <input type="hidden" name="t" value="@ViewBag.Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3"><label class="form-label">@T("Mật khẩu mới")</label><input type="password" name="password" class="form-control" required autocomplete="new-password" /></div>
            <div class="mb-3"><label class="form-label">@T("Xác nhận mật khẩu mới")</label><input type="password" name="confirm" class="form-control" required autocomplete="new-password" /></div>
            <button class="btn btn-primary w-100">@T("Đặt mật khẩu")</button>
        </form>
    }
</div></div>
