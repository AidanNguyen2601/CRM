@{ ViewData["Title"] = T("Đăng nhập"); }
<div class="card mx-auto" style="max-width:420px"><div class="card-body p-4">
    <h4 class="mb-1">@T("Cổng khách hàng")</h4>
    <p class="text-muted small mb-3">@T("Gửi và theo dõi yêu cầu hỗ trợ, xem hoá đơn, hợp đồng của công ty bạn.")</p>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" required autofocus /></div>
        <div class="mb-3"><label class="form-label">@T("Mật khẩu")</label><input type="password" name="password" class="form-control" required /></div>
        <button class="btn btn-primary w-100">@T("Đăng nhập")</button>
    </form>
    <div class="text-end mt-2"><a class="small" asp-action="Forgot">@T("Quên mật khẩu?")</a></div>
    <div class="small text-muted mt-3">@T("Chưa có tài khoản? Liên hệ nhân viên phụ trách để được mời sử dụng cổng khách hàng.")</div>
</div></div>
