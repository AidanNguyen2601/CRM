@model List<AppUser>
@{
    ViewData["Title"] = T("Người dùng & phân quyền");
    var stats = (Dictionary<int, (int Leads, int Opps, int Customers)>)ViewBag.Stats;
    var snap = (BranchSnapshot)ViewBag.Snapshot;
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Đơn vị")</label>
        <select name="branchId" class="form-select" asp-items="ViewBag.BranchOptions" onchange="this.form.submit()"><option value="">@T("-- Toàn chuỗi --")</option></select></div>
    <a class="btn btn-outline-secondary" asp-controller="Branches" asp-action="Index">@Icon("branch") @T("Công ty & chi nhánh")</a>
    <a class="btn btn-primary ms-auto" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">@T("+ Thêm người dùng")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Tên đăng nhập")</th><th>@T("Họ tên")</th><th>Email</th><th>@T("Vai trò")</th><th>@T("Đơn vị")</th><th class="text-center">Lead</th><th class="text-center">@T("Cơ hội mở")</th><th class="text-center">@T("Khách hàng")</th><th>@T("Trạng thái")</th><th>@T("Đăng nhập gần nhất")</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        var s = stats[u.Id];
        <tr>
            <td><b>@u.Username</b></td><td>@u.FullName</td><td>@u.Email</td>
            <td><span class="badge bg-primary">@AppRoles.DisplayName(u.Role)</span></td>
            <td class="small" title="@snap.PathOf(u.BranchId)">@snap.NameOf(u.BranchId)</td>
            <td class="text-center">@s.Leads</td><td class="text-center">@s.Opps</td><td class="text-center">@s.Customers</td>
            <td>@(u.IsActive ? Html.Raw($"<span class='badge bg-success'>{T("Hoạt động")}</span>") : Html.Raw($"<span class='badge bg-secondary'>{T("Đã khóa")}</span>"))</td>
            <td>@u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">@T("Sửa")</a></td>
        </tr>
    }
    </tbody>
</table>
</div></div>
<div class="card mt-3"><div class="card-body small">
    <b>@T("Phân quyền:")</b>
    <ul class="mb-0">
        <li><b>@T("Quản trị hệ thống")</b>@T(": toàn quyền, quản lý người dùng.")</li>
        <li><b>@T("Quản lý kinh doanh")</b>@T(": xem và chỉnh toàn bộ dữ liệu, phân công người phụ trách, quản lý danh mục.")</li>
        <li><b>@T("Nhân viên kinh doanh")</b>@T(": chỉ xem và làm việc với lead, khách hàng, cơ hội, báo giá, hoạt động mình phụ trách.")</li>
        <li><b>@T("Nhân viên chăm sóc khách hàng")</b>@T(": xử lý phiếu hỗ trợ của các đơn vị trong phạm vi.")</li>
        <li>@T("Phạm vi dữ liệu theo đơn vị: quản trị hệ thống thấy toàn chuỗi; người dùng khác thấy dữ liệu của đơn vị mình và các đơn vị trực thuộc.")</li>
    </ul>
</div></div>
