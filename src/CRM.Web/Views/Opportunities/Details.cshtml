@model OpportunityDetailViewModel
@{
    var o = Model.Opportunity;
    ViewData["Title"] = o.Name;
    var openStages = new[] { OpportunityStage.Prospecting, OpportunityStage.Qualification, OpportunityStage.Proposal, OpportunityStage.Negotiation };
}
<div class="card mb-3"><div class="card-body">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @foreach (var s in openStages)
        {
            var passed = !o.IsClosed && (int)o.Stage >= (int)s || o.Stage == OpportunityStage.ClosedWon;
            <form asp-action="ChangeStage" asp-route-id="@o.Id" method="post">
                <input type="hidden" name="stage" value="@((int)s)" />
                <button class="btn btn-sm @(o.Stage == s ? "btn-primary" : passed ? "btn-outline-primary" : "btn-outline-secondary")">@s.GetDisplayName()</button>
            </form>
            <span class="text-muted">›</span>
        }
        <form asp-action="ChangeStage" asp-route-id="@o.Id" method="post" data-confirm="@T("Đánh dấu THẮNG cơ hội này?")">
            <input type="hidden" name="stage" value="@((int)OpportunityStage.ClosedWon)" />
            <button class="btn btn-sm @(o.Stage == OpportunityStage.ClosedWon ? "btn-success" : "btn-outline-success")">@T("Thắng")</button>
        </form>
        <form asp-action="ChangeStage" asp-route-id="@o.Id" method="post" class="d-flex gap-1">
            <input type="hidden" name="stage" value="@((int)OpportunityStage.ClosedLost)" />
            <input name="lostReason" list="lossReasons" class="form-control form-control-sm" placeholder="@T("Lý do thua")" value="@o.LostReason" style="width:180px" />
            <button class="btn btn-sm @(o.Stage == OpportunityStage.ClosedLost ? "btn-danger" : "btn-outline-danger")">Thua</button>
        </form>
    </div>
</div></div>
<partial name="_CatalogDatalist" model='("lossReasons", CatalogGroup.LossReason)' />
<div class="toolbar">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@o.Id">@T("Sửa")</a>
    <a class="btn btn-outline-secondary" asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@o.Id">@T("+ Hoạt động")</a>
    <a class="btn btn-outline-secondary" asp-controller="Quotes" asp-action="Create" asp-route-opportunityId="@o.Id">@T("+ Báo giá")</a>
    <form asp-action="Delete" asp-route-id="@o.Id" method="post" data-confirm="@T("Xóa cơ hội này?")" class="ms-auto"><button class="btn btn-outline-danger">@T("Xóa")</button></form>
</div>
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <div class="small text-muted">@T("Giá trị")</div>
            <div class="fs-3 fw-bold">@o.Amount.ToMoney() <small class="fs-6 text-muted">@L("đ", "VND")</small></div>
            <div class="small text-muted mb-2">@T("Xác suất {0}% · trọng số {1}", o.Probability, o.WeightedAmount.ToMoney())</div>
            <partial name="_Badge" model="o.Stage" />
            <hr />
            <dl class="row small mb-0 info">
                <dt class="col-5">@T("Khách hàng")</dt><dd class="col-7"><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.Customer?.Name</a></dd>
                <dt class="col-5">@T("Liên hệ")</dt><dd class="col-7">@o.Contact?.FullName<br /><span class="text-muted">@o.Contact?.Phone</span></dd>
                <dt class="col-5">@T("Dự kiến chốt")</dt><dd class="col-7">@o.ExpectedCloseDate.ToDate()</dd>
                @if (o.IsClosed) { <dt class="col-5">@T("Ngày chốt")</dt><dd class="col-7">@o.ClosedAt.ToDate()</dd> }
                @if (o.Stage == OpportunityStage.ClosedLost) { <dt class="col-5">@T("Lý do thua")</dt><dd class="col-7">@o.LostReason</dd> }
                <dt class="col-5">@T("Nguồn")</dt><dd class="col-7">@o.Source?.GetDisplayName()</dd>
                <dt class="col-5">@T("Phụ trách")</dt><dd class="col-7">@o.Owner?.FullName</dd>
                <dt class="col-5">@T("Ngày tạo")</dt><dd class="col-7">@o.CreatedAt.ToDate()</dd>
            </dl>
            @if (!string.IsNullOrEmpty(o.Description)) { <hr /><div class="small pre">@o.Description</div> }
        </div></div>
    </div>
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header">@T("Báo giá")</div>
            <div class="card-body p-0"><table class="table mb-0">
                <thead><tr><th>@T("Số báo giá")</th><th>@T("Ngày")</th><th class="money">@T("Tổng thanh toán")</th><th>@T("Trạng thái")</th></tr></thead>
                <tbody>
                @foreach (var q in Model.Quotes)
                {
                    <tr><td><a asp-controller="Quotes" asp-action="Details" asp-route-id="@q.Id">@q.Number</a></td><td>@q.QuoteDate.ToDate()</td>
                        <td class="money">@q.Total.ToMoney()</td><td><partial name="_Badge" model="q.Status" /></td></tr>
                }
                @if (!Model.Quotes.Any()) { <tr><td colspan="4" class="text-muted p-3">@T("Chưa có báo giá.")</td></tr> }
                </tbody>
            </table></div>
        </div>
        <div class="card"><div class="card-header">@T("Hoạt động")</div>
            <div class="card-body"><partial name="_ActivityList" model="Model.Activities" /></div>
        </div>
    </div>
</div>
