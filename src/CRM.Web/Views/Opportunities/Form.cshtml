@model Opportunity
@{ ViewData["Title"] = Model.Id == 0 ? T("Thêm cơ hội bán hàng") : T("Sửa cơ hội: {0}", Model.Name); }
<div class="card" style="max-width:960px"><div class="card-body">
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAt" /><input type="hidden" asp-for="ClosedAt" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()"><option value="">--</option></select></div>
        <div class="col-md-6"><label asp-for="CampaignId" class="form-label"></label><select asp-for="CampaignId" class="form-select" asp-items="ViewBag.Campaigns"><option value="">@T("-- Không thuộc chiến dịch --")</option></select></div>
        <div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" data-contacts-for="#ContactId"><option value="">@T("-- Chọn khách hàng --")</option></select><span asp-validation-for="CustomerId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="ContactId" class="form-label"></label><select asp-for="ContactId" class="form-select" asp-items="ViewBag.Contacts"><option value="">@T("-- Chọn --")</option></select></div>
        <div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()" id="Stage"></select></div>
        <div class="col-md-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /><span asp-validation-for="Amount" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" id="Probability" /></div>
        <div class="col-md-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" /></div>
        @if (User.SeesAll()) { <div class="col-md-4"><label asp-for="OwnerId" class="form-label"></label><select asp-for="OwnerId" class="form-select" asp-items="ViewBag.Owners"></select></div> }
        <div class="col-md-8"><label asp-for="LostReason" class="form-label"></label><input asp-for="LostReason" class="form-control" list="lossReasons" /><partial name="_CatalogDatalist" model='("lossReasons", CatalogGroup.LossReason)' /><span asp-validation-for="LostReason" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
        @await Component.InvokeAsync("CustomFields", new { type = "Opportunity", id = Model.Id, edit = true })
    </div>
    <div class="mt-4"><button class="btn btn-primary">@T("Lưu")</button> <a asp-action="Index" class="btn btn-light">@T("Hủy")</a></div>
</form>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Đổi giai đoạn → gợi ý xác suất mặc định (giá trị enum = %)
        document.getElementById('Stage').addEventListener('change', function () { document.getElementById('Probability').value = this.value; });
    </script>
}
