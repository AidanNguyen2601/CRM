@model List<Opportunity>
@{
    ViewData["Title"] = T("Pipeline bán hàng");
    var stages = new[] { OpportunityStage.Prospecting, OpportunityStage.Qualification, OpportunityStage.Proposal, OpportunityStage.Negotiation };
}
<form method="get" class="toolbar">
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="ownerId" class="form-select" asp-items="ViewBag.Owners" onchange="this.form.submit()"><option value="">@T("-- Tất cả --")</option></select></div> }
    <div class="small text-muted ms-2 mb-2">@T("Tổng pipeline:") <b>@Model.Sum(o => o.Amount).ToMoney()</b> · @T("Trọng số:") <b>@Model.Sum(o => o.WeightedAmount).ToMoney()</b></div>
    <a class="btn btn-outline-secondary ms-auto" asp-action="Index">@T("Dạng bảng")</a>
    <a class="btn btn-primary" asp-action="Create">@T("+ Thêm cơ hội")</a>
</form>
<div class="kanban">
@foreach (var s in stages)
{
    var items = Model.Where(o => o.Stage == s).ToList();
    <div class="kanban-col">
        <h6><span>@s.GetDisplayName()</span><span class="badge bg-secondary">@items.Count</span></h6>
        <div class="sum">@items.Sum(o => o.Amount).ToShortMoney() · @T("xác suất {0}%", (int)s)</div>
        @foreach (var o in items)
        {
            <div class="kcard @(o.ExpectedCloseDate < DateTime.Today ? "late" : "")">
                <a class="name" asp-action="Details" asp-route-id="@o.Id">@o.Name</a>
                <div class="meta">@o.Customer?.Name</div>
                <div class="d-flex justify-content-between meta mt-1"><b class="text-dark">@o.Amount.ToShortMoney()</b><span>@o.ExpectedCloseDate?.ToString("dd/MM")</span></div>
                <div class="meta">@o.Owner?.FullName</div>
                <form asp-action="ChangeStage" asp-route-id="@o.Id" method="post" class="mt-2">
                    <input type="hidden" name="returnTo" value="pipeline" />
                    <select name="stage" class="form-select form-select-sm" data-stage-select>
                        <option value="">@T("Chuyển giai đoạn…")</option>
                        @foreach (var t in Enum.GetValues<OpportunityStage>().Where(x => x != s))
                        {
                            <option value="@((int)t)">@t.GetDisplayName()</option>
                        }
                    </select>
                    <input type="hidden" name="lostReason" />
                </form>
            </div>
        }
    </div>
}
</div>
@section Scripts {
<script>
    // Chuyển giai đoạn ngay trên thẻ; chọn "Thua" → hỏi lý do bằng hộp thoại của ứng dụng
    document.querySelectorAll('[data-stage-select]').forEach(sel => sel.addEventListener('change', async () => {
        if (!sel.value) return;
        if (sel.value === '0') {
            const reason = await CrmDialog.prompt(@Json.Serialize(T("Lý do thua?")), { title: @Json.Serialize(T("Đánh dấu cơ hội thua")), required: true, multiline: true, danger: true });
            if (!reason) { sel.selectedIndex = 0; return; }
            sel.form.lostReason.value = reason;
        }
        sel.form.submit();
    }));
</script>
}
