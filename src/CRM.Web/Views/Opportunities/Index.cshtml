@model PagedList<Opportunity>
@{
    ViewData["Title"] = T("Cơ hội bán hàng");
    var f = (OpportunityFilter)ViewBag.Filter;
    var stageItems = Html.GetEnumSelectList<OpportunityStage>().ToList();
    foreach (var i in stageItems) i.Selected = f.Stage.HasValue && i.Value == ((int)f.Stage.Value).ToString();
    string Tab(string s) => (f.Scope ?? "open") == s ? "active" : "";
}
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @Tab("open")" asp-route-Scope="open">@T("Đang mở")</a></li>
    <li class="nav-item"><a class="nav-link @Tab("won")" asp-route-Scope="won">@T("Đã thắng")</a></li>
    <li class="nav-item"><a class="nav-link @Tab("lost")" asp-route-Scope="lost">@T("Đã thua")</a></li>
    <li class="nav-item"><a class="nav-link @Tab("all")" asp-route-Scope="all">@T("Tất cả")</a></li>
</ul>
<form method="get" class="toolbar">
    <input type="hidden" name="Scope" value="@f.Scope" />
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Tên cơ hội, khách hàng")" /></div>
    <div><label class="form-label small mb-1">@T("Giai đoạn")</label><select name="Stage" class="form-select" asp-items="stageItems"><option value="">@T("-- Tất cả --")</option></select></div>
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div> }
    <partial name="_TagFilter" />
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-outline-secondary ms-auto" asp-action="Pipeline">Xem Kanban</a>
    <a class="btn btn-primary" asp-action="Create">@T("+ Thêm cơ hội")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Cơ hội")</th><th>@T("Khách hàng")</th><th>@T("Giai đoạn")</th><th class="money">@T("Giá trị")</th><th class="text-center">@T("Xác suất")</th><th>@T("Dự kiến chốt")</th><th>@T("Phụ trách")</th></tr></thead>
    <tbody>
    @foreach (var o in Model.Items)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@o.Id" class="fw-semibold">@o.Name</a><partial name="_RowExtras" model="o.Id" /></td>
            <td>@o.Customer?.Name</td>
            <td><partial name="_Badge" model="o.Stage" /></td>
            <td class="money">@o.Amount.ToMoney()</td>
            <td class="text-center">@o.Probability%</td>
            <td class="@(!o.IsClosed && o.ExpectedCloseDate < DateTime.Today ? "text-danger" : "")">@(o.IsClosed ? o.ClosedAt.ToDate() : o.ExpectedCloseDate.ToDate())</td>
            <td>@o.Owner?.FullName</td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-center text-muted p-4">@T("Không có cơ hội.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">@T("{0} cơ hội · tổng giá trị", Model.TotalCount) <b>@(((decimal)ViewBag.TotalAmount).ToMoney())</b></span>
    <partial name="_Pager" model="Model" />
</div></div>
