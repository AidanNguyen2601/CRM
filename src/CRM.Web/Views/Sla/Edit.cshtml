@model SlaPolicy
@{ ViewData["Title"] = Model.Id == 0 ? T("Thêm chính sách SLA") : T("Sửa chính sách SLA: {0}", Model.Name); }
<div class="card" style="max-width:820px"><div class="card-body">
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="@T("Vd. Gói Vàng, Khách hàng VIP")" /></div>
        <div class="col-md-6"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
        <div class="col-12">
            <table class="table table-sm align-middle mb-0" style="max-width:560px">
                <thead><tr><th>@T("Độ ưu tiên")</th><th>@T("Phản hồi trong (giờ)")</th><th>@T("Giải quyết trong (giờ)")</th></tr></thead>
                <tbody>
                    <tr><td>@TicketPriority.Urgent.GetDisplayName()</td><td><input asp-for="UrgentResponse" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td><td><input asp-for="UrgentResolve" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td></tr>
                    <tr><td>@TicketPriority.High.GetDisplayName()</td><td><input asp-for="HighResponse" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td><td><input asp-for="HighResolve" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td></tr>
                    <tr><td>@TicketPriority.Normal.GetDisplayName()</td><td><input asp-for="NormalResponse" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td><td><input asp-for="NormalResolve" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td></tr>
                    <tr><td>@TicketPriority.Low.GetDisplayName()</td><td><input asp-for="LowResponse" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td><td><input asp-for="LowResolve" type="number" step="0.25" min="0.25" class="form-control form-control-sm" /></td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" asp-for="BusinessHours" /><label class="form-check-label" asp-for="BusinessHours"></label>
                <div class="small text-muted">@T("Bỏ qua ngoài giờ, ngày nghỉ và ngày lễ theo lịch làm việc. Tắt = tính liên tục 24/7.")</div></div>
            <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" asp-for="PauseWhenWaiting" /><label class="form-check-label" asp-for="PauseWhenWaiting"></label>
                <div class="small text-muted">@T("Thời gian phiếu ở trạng thái \"Chờ khách phản hồi\" không tính vào hạn.")</div></div>
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="Escalate" /><label class="form-check-label" asp-for="Escalate"></label>
                <div class="small text-muted">@T("Thông báo quản lý gần nhất của đơn vị khi phiếu trễ hạn, hoặc phiếu chưa phân công sắp đến hạn.")</div></div>
        </div>
        <div class="col-md-6">
            <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive"></label></div>
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="IsDefault" /><label class="form-check-label" asp-for="IsDefault"></label>
                <div class="small text-muted">@T("Áp cho mọi phiếu của khách hàng / hợp đồng không có SLA riêng.")</div></div>
        </div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">@T("Lưu")</button> <a asp-action="Index" class="btn btn-light">@T("Hủy")</a></div>
</form>
</div></div>
