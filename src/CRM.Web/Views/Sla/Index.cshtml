@model List<SlaPolicy>
@{
    ViewData["Title"] = T("SLA & giờ làm việc");
    var cal = (SlaCalendarSettings)ViewBag.Calendar;
    var usage = (Dictionary<string, Dictionary<int, int>>)ViewBag.Usage;
    string H(decimal v) => v.ToString("0.##");
    var days = new[] { (1, T("Thứ 2")), (2, T("Thứ 3")), (3, T("Thứ 4")), (4, T("Thứ 5")), (5, T("Thứ 6")), (6, T("Thứ 7")), (0, T("Chủ nhật")) };
}
<div class="toolbar">
    <a class="btn btn-primary" asp-action="Edit">@Icon("plus") @T("Thêm chính sách")</a>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="card"><div class="card-header">@Icon("clock") @T("Chính sách SLA")</div>
            <div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
                <thead><tr><th>@T("Tên chính sách")</th><th class="text-center">@T("Khẩn cấp")</th><th class="text-center">@T("Cao")</th><th class="text-center">@T("Trung bình")</th><th class="text-center">@T("Thấp")</th><th>@T("Cách tính")</th><th>@T("Đang áp dụng")</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsActive ? "" : "text-muted")">
                        <td><a asp-action="Edit" asp-route-id="@p.Id" class="fw-semibold">@p.Name</a>
                            @if (p.IsDefault) { <span class="badge text-bg-primary ms-1">@T("Mặc định")</span> }
                            @if (!p.IsActive) { <span class="badge text-bg-secondary ms-1">@T("Ngừng dùng")</span> }
                            @if (!string.IsNullOrEmpty(p.Description)) { <div class="small text-muted">@p.Description</div> }</td>
                        @foreach (var pr in new[] { TicketPriority.Urgent, TicketPriority.High, TicketPriority.Normal, TicketPriority.Low })
                        {
                            var (a, b) = p.For(pr);
                            <td class="text-center text-nowrap small">@H(a)h / @H(b)h</td>
                        }
                        <td class="small">@(p.BusinessHours ? T("Giờ làm việc") : "24/7")@if (p.PauseWhenWaiting) { <div>@T("Dừng khi chờ khách")</div> }@if (p.Escalate) { <div>@T("Báo quản lý khi trễ")</div> }</td>
                        <td class="small text-nowrap">@T("{0} khách hàng", usage["customers"].GetValueOrDefault(p.Id))<br />@T("{0} hợp đồng", usage["contracts"].GetValueOrDefault(p.Id))<br />@T("{0} phiếu đang mở", usage["open"].GetValueOrDefault(p.Id))</td>
                        <td class="text-end">
                            @if (!p.IsDefault)
                            {
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" data-confirm="@T("Xóa chính sách SLA \"{0}\"?", p.Name)"><button class="btn btn-sm btn-outline-danger">@T("Xóa")</button></form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="8" class="text-muted p-3">@T("Chưa có chính sách – phiếu dùng mức chuẩn của hệ thống (24/7).")</td></tr> }
                </tbody>
            </table></div></div>
            <div class="card-footer small text-muted">@T("Thời hạn ghi dạng phản hồi / giải quyết (giờ). Thứ tự áp dụng cho phiếu: SLA của hợp đồng gắn phiếu → SLA của khách hàng → chính sách mặc định. Gắn SLA riêng trên trang sửa khách hàng hoặc hợp đồng.")</div>
        </div>
    </div>
    <div class="col-xl-4">
        <form asp-action="Calendar" method="post" class="card">
            <div class="card-header">@Icon("calendar") @T("Lịch làm việc")</div>
            <div class="card-body">
                <label class="form-label">@T("Ngày làm việc")</label>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var (v, label) in days)
                    {
                        <div class="form-check form-check-inline me-1"><input class="form-check-input" type="checkbox" name="workDays" value="@v" id="wd@(v)" @(cal.WorkDays.Contains(v) ? "checked" : "") /><label class="form-check-label" for="wd@(v)">@label</label></div>
                    }
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="form-label">@T("Bắt đầu")</label><input type="time" name="start" value="@cal.Start" class="form-control" required /></div>
                    <div class="col-6"><label class="form-label">@T("Kết thúc")</label><input type="time" name="end" value="@cal.End" class="form-control" required /></div>
                    <div class="col-6"><label class="form-label">@T("Nghỉ trưa từ")</label><input type="time" name="breakStart" value="@cal.BreakStart" class="form-control" /></div>
                    <div class="col-6"><label class="form-label">@T("đến")</label><input type="time" name="breakEnd" value="@cal.BreakEnd" class="form-control" /></div>
                </div>
                <label class="form-label">@T("Ngày lễ (mỗi dòng một ngày)")</label>
                <textarea name="holidays" class="form-control font-monospace" rows="7" placeholder="01/01&#10;30/04&#10;29/01/2026">@cal.Holidays</textarea>
                <div class="small text-muted mt-1">@T("dd/MM = lặp hằng năm (Tết Dương lịch, 30/4, 1/5, 2/9); dd/MM/yyyy = một ngày cụ thể (Tết Nguyên đán, Giỗ Tổ, nghỉ bù).")</div>
            </div>
            <div class="card-footer"><button class="btn btn-primary">@T("Lưu lịch làm việc")</button></div>
        </form>
    </div>
</div>
