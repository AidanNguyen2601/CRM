@model List<Product>
@{ ViewData["Title"] = T("Sản phẩm / dịch vụ"); var canEdit = User.SeesAll(); }
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="@T("Mã, tên")" /></div>
    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="ina" @(ViewBag.ShowInactive == true ? "checked" : "") /><label for="ina" class="form-check-label">@T("Hiện cả ngừng kinh doanh")</label></div>
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    @if (canEdit) { <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Thêm sản phẩm")</a> }
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Mã")</th><th>@T("Tên sản phẩm / dịch vụ")</th><th>@T("Nhóm")</th><th>@T("ĐVT")</th><th class="money">@T("Đơn giá")</th><th>@T("Trạng thái")</th>@if (canEdit) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><b>@p.Code</b></td><td>@p.Name<div class="small text-muted">@p.Description</div></td><td>@Catalogs.Text(CatalogGroup.ProductCategory, p.Category)</td><td>@Catalogs.Text(CatalogGroup.Unit, p.Unit)</td>
            <td class="money">@p.UnitPrice.ToMoney()</td>
            <td>@(p.IsActive ? Html.Raw($"<span class='badge bg-success'>{T("Đang bán")}</span>") : Html.Raw($"<span class='badge bg-secondary'>{T("Ngừng")}</span>"))</td>
            @if (canEdit) { <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">@T("Sửa")</a></td> }
        </tr>
    }
    </tbody>
</table>
</div></div>
