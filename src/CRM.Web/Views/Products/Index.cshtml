@model List<Product>
@{
    ViewData["Title"] = T("Hàng hoá / dịch vụ");
    var canEdit = User.SeesAll();
    var type = ViewBag.Type as ProductType?;
    var typeItems = Html.GetEnumSelectList<ProductType>().ToList();
    foreach (var i in typeItems) i.Selected = type.HasValue && i.Value == ((int)type.Value).ToString();
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="@T("Mã, tên, hãng")" /></div>
    <div><label class="form-label small mb-1">@T("Loại")</label><select name="type" class="form-select" asp-items="typeItems"><option value="">@T("-- Tất cả --")</option></select></div>
    <div><label class="form-label small mb-1">@T("Nhóm")</label><select name="category" class="form-select" asp-items="Catalogs.Options(CatalogGroup.ProductCategory, ViewBag.Category as string)"><option value="">@T("-- Tất cả --")</option></select></div>
    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="ina" @(ViewBag.ShowInactive == true ? "checked" : "") /><label for="ina" class="form-check-label">@T("Hiện cả ngừng kinh doanh")</label></div>
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    @if (canEdit) { <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Thêm hàng hoá")</a> }
</form>
<div class="card"><div class="card-body p-0 table-responsive">
<table class="table table-hover mb-0">
    <thead><tr>
        <th>@T("Mã")</th><th>@T("Tên hàng hoá / dịch vụ")</th><th>@T("Loại")</th><th>@T("Nhóm")</th><th>@T("Hãng / xuất xứ")</th><th>@T("ĐVT")</th>
        @if (canEdit) { <th class="money">@T("Giá vốn")</th> }
        <th class="money">@T("Giá bán")</th>
        @if (canEdit) { <th class="text-center">@T("Biên LN")</th> }
        <th class="text-center">VAT</th><th>@T("Trạng thái")</th>@if (canEdit) { <th></th> }
    </tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td class="text-nowrap"><b>@p.Code</b></td>
            <td>@p.Name
                @if (!string.IsNullOrEmpty(p.Specification)) { <div class="small text-muted">@p.Specification</div> }
                else if (!string.IsNullOrEmpty(p.Description)) { <div class="small text-muted">@p.Description</div> }
                @if (p.WarrantyMonths > 0) { <div class="small text-muted">@T("Bảo hành {0} tháng", p.WarrantyMonths)</div> }</td>
            <td><span class="badge @(p.Type == ProductType.Goods ? "bg-primary" : "bg-info text-dark")">@p.Type.GetDisplayName()</span></td>
            <td>@Catalogs.Text(CatalogGroup.ProductCategory, p.Category)</td>
            <td class="small">@Catalogs.Text(CatalogGroup.Brand, p.Brand)@(p.Brand != null && p.Origin != null ? " · " : "")@Catalogs.Text(CatalogGroup.Origin, p.Origin)</td>
            <td>@Catalogs.Text(CatalogGroup.Unit, p.Unit)</td>
            @if (canEdit) { <td class="money">@(p.CostPrice > 0 ? p.CostPrice.ToMoney() : "–")</td> }
            <td class="money">@p.UnitPrice.ToMoney()</td>
            @if (canEdit) { <td class="text-center">@if (p.GrossMargin > 0) { <span class="badge @BusinessPlan.MarginCss(p.GrossMargin)">@p.GrossMargin.ToString("0.#")%</span> } else { <text>–</text> }</td> }
            <td class="text-center">@p.VatPercent.ToString("0.##")%</td>
            <td>@(p.IsActive ? Html.Raw($"<span class='badge bg-success'>{T("Đang bán")}</span>") : Html.Raw($"<span class='badge bg-secondary'>{T("Ngừng")}</span>"))</td>
            @if (canEdit) { <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">@T("Sửa")</a></td> }
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="12" class="text-center text-muted p-4">@T("Không có hàng hoá.")</td></tr> }
    </tbody>
</table>
</div></div>
