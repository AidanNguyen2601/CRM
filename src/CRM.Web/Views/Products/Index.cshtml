@model List<Product>
@{ ViewData["Title"] = "Sản phẩm / dịch vụ"; var canEdit = User.SeesAll(); }
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">Tìm kiếm</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Mã, tên" /></div>
    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="ina" @(ViewBag.ShowInactive == true ? "checked" : "") /><label for="ina" class="form-check-label">Hiện cả ngừng kinh doanh</label></div>
    <button class="btn btn-outline-primary">Lọc</button>
    @if (canEdit) { <a class="btn btn-primary ms-auto" asp-action="Create">+ Thêm sản phẩm</a> }
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>Mã</th><th>Tên sản phẩm / dịch vụ</th><th>Nhóm</th><th>ĐVT</th><th class="money">Đơn giá</th><th>Trạng thái</th>@if (canEdit) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><b>@p.Code</b></td><td>@p.Name<div class="small text-muted">@p.Description</div></td><td>@p.Category</td><td>@p.Unit</td>
            <td class="money">@p.UnitPrice.ToMoney()</td>
            <td>@(p.IsActive ? Html.Raw("<span class='badge bg-success'>Đang bán</span>") : Html.Raw("<span class='badge bg-secondary'>Ngừng</span>"))</td>
            @if (canEdit) { <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a></td> }
        </tr>
    }
    </tbody>
</table>
</div></div>
