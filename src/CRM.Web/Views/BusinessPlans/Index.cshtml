@model PagedList<BusinessPlan>
@{
    ViewData["Title"] = T("Phương án kinh doanh");
    var f = (BusinessPlanFilter)ViewBag.Filter;
    var counts = (Dictionary<BusinessPlanStatus, int>)ViewBag.Counts;
    var sumRevenue = (decimal)ViewBag.SumRevenue;
    var sumProfit = (decimal)ViewBag.SumProfit;
    string Tab(BusinessPlanStatus? s) => f.Status == s ? "active" : "";
    int Count(BusinessPlanStatus s) => counts.TryGetValue(s, out var n) ? n : 0;
}
<ul class="nav nav-pills mb-3 flex-wrap">
    <li class="nav-item"><a class="nav-link @Tab(null)" asp-route-Keyword="@f.Keyword" asp-route-OwnerId="@f.OwnerId">@T("Tất cả") <span class="badge bg-secondary">@counts.Values.Sum()</span></a></li>
    @foreach (var s in Enum.GetValues<BusinessPlanStatus>())
    {
        <li class="nav-item">
            <a class="nav-link @Tab(s)" asp-route-Status="@s" asp-route-Keyword="@f.Keyword" asp-route-OwnerId="@f.OwnerId">
                @s.GetDisplayName() <span class="badge @(s == BusinessPlanStatus.Pending && Count(s) > 0 ? "bg-warning text-dark" : "bg-secondary")">@Count(s)</span>
            </a>
        </li>
    }
</ul>
<form method="get" class="toolbar">
    <input type="hidden" name="Status" value="@f.Status" />
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Số, tên phương án, khách hàng")" /></div>
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div> }
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">@Icon("plus") @T("Lập phương án")</a>
</form>
<div class="card"><div class="card-body p-0 table-responsive">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Số PAKD")</th><th>@T("Tên phương án")</th><th>@T("Khách hàng")</th><th class="money">@T("Doanh thu")</th><th class="money">@T("Lợi nhuận")</th><th class="text-center">@T("Tỷ suất")</th><th>@T("Trạng thái")</th><th>@T("Phụ trách")</th><th>@T("Ngày lập")</th></tr></thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold text-nowrap">@p.Number</a></td>
            <td>@p.Title</td>
            <td>@p.Customer?.Name</td>
            <td class="money">@p.Revenue.ToMoney()</td>
            <td class="money @(p.Profit < 0 ? "text-danger" : "")">@p.Profit.ToMoney()</td>
            <td class="text-center"><span class="badge @BusinessPlan.MarginCss(p.MarginPercent)">@p.MarginPercent.ToString("0.#")%</span></td>
            <td><partial name="_Badge" model="p.Status" /></td>
            <td>@p.Owner?.FullName</td>
            <td>@p.PlanDate.ToDate()</td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="9" class="text-center text-muted p-4">@T("Chưa có phương án kinh doanh.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="small text-muted">
        @T("{0} phương án", Model.TotalCount)
        · @T("Doanh thu") <b>@sumRevenue.ToMoney()</b> · @T("Lợi nhuận") <b class="@(sumProfit < 0 ? "text-danger" : "")">@sumProfit.ToMoney()</b>
    </span>
    <partial name="_Pager" model="Model" />
</div></div>
