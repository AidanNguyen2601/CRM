@model PagedList<Contact>
@{
    ViewData["Title"] = T("Người liên hệ");
    var f = (ListFilter)ViewBag.Filter;
    int? customerId = ViewBag.CustomerId;
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@T("Tìm kiếm")</label><input name="Keyword" value="@f.Keyword" class="form-control" placeholder="@T("Tên, email, SĐT, khách hàng")" /></div>
    @if (User.SeesAll()) { <div><label class="form-label small mb-1">@T("Phụ trách")</label><select name="OwnerId" class="form-select" asp-items="ViewBag.Owners"><option value="">@T("-- Tất cả --")</option></select></div> }
    <button class="btn btn-outline-primary">@T("Lọc")</button>
    <a class="btn btn-primary ms-auto" asp-action="Create">@T("+ Thêm liên hệ")</a>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
    <thead><tr><th>@T("Họ tên")</th><th>@T("Chức vụ")</th><th>@T("Khách hàng")</th><th>@T("Điện thoại")</th><th>Email</th><th>@T("Phụ trách")</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td class="fw-semibold">@c.FullName @if (c.IsPrimary) { <span class="badge bg-success">@T("Chính")</span> }</td>
            <td>@c.JobTitle</td>
            <td>@if (c.Customer != null) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId">@c.Customer.Name</a> }</td>
            <td>@c.Phone</td>
            <td>@c.Email</td>
            <td>@c.Owner?.FullName</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">@T("Sửa")</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="@T("Xóa liên hệ {0}?", c.FullName)"><button class="btn btn-sm btn-outline-danger">@T("Xóa")</button></form>
            </td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-center text-muted p-4">@T("Không có người liên hệ.")</td></tr> }
    </tbody>
</table>
</div>
<div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">@T("Tổng: {0} người liên hệ", Model.TotalCount)</span>
    <partial name="_Pager" model="Model" />
</div></div>
