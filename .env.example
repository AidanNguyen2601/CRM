# Copy thành .env rồi sửa. Chọn port KHÔNG trùng app Healthcare / HRM (kiểm tra: docker ps)
CRM_WEB_PORT=8100
CRM_DB_PORT=1435
CRM_SA_PASSWORD=Crm@Strong2026
# Số khách hàng mẫu khi khởi tạo database MỚI (kèm liên hệ, cơ hội, báo giá, hợp đồng, hoá đơn, KPI...).
# Để trống = bộ mẫu mặc định (8 khách hàng). Chỉ có tác dụng ở lần chạy đầu khi DB còn trống.
CRM_SAMPLE_CUSTOMERS=5

# ---- Phương án B: dùng chung SQL Server đang có (script deploy-crm-shared-db.ps1 tự điền) ----
SHARED_NETWORK=healthcare_default
SHARED_DB_HOST=healthcare-sqlserver
SHARED_DB_USER=crm_app
SHARED_DB_PASSWORD=ChangeMe@123
